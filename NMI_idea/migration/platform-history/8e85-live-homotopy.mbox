+            scan_achieved=(
+                np.asarray(scan_achieved, dtype=float).copy()
+                if scan_achieved is not None
+                else np.zeros(2)
+            ),
+            scan_residual=(
+                np.asarray(scan_residual, dtype=float).copy()
+                if scan_residual is not None
+                else np.zeros(2)
+            ),
