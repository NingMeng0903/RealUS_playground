+        ("v_force_z", "<f8"),
+        ("pose_d", "<f8", (6,)),
+        ("vel_ff", "<f8", (6,)),
+        ("qdot_ff", "<f8", (8,)),
+        ("path_twist", "<f8", (6,)),
+        ("feedback_twist", "<f8", (6,)),
+        ("cmd_f", "<f8", (16,)),
+        ("cmd_u", "<u4", (8,)),
+    ],
+    align=False,
+)
+
+WBC_OUT_DTYPE = np.dtype(
+    [
+        ("magic", "<u4"),
+        ("version", "<u4"),
+        ("seq", "<u8"),
+        ("cmd_ack", "<u8"),
+        ("status", "<u4"),
+        ("flags", "<u4"),
+        ("q_cmd", "<f8", (8,)),
+        ("qdot", "<f8", (8,)),
+        ("v_cmd_received", "<f8", (6,)),
+        ("v_cmd_feasible", "<f8", (6,)),
+        ("v_tcp_estimated", "<f8", (6,)),
+        ("task_residual", "<f8", (6,)),
+        ("slack", "<f8"),
+        ("e_qp", "<f8"),
+        ("u_alloc", "<f8"),
+        ("u_mid", "<f8"),
+        ("v_r_ref", "<f8"),
+        ("psi", "<f8"),
+        ("d_star", "<f8"),
+        ("d_pref", "<f8"),
+        ("solve_ms", "<f8"),
+        ("sigma_min", "<f8"),
+        ("sigma_arm", "<f8"),
+        ("cmd_f", "<f8", (8,)),
+        ("joint_limited", "<u4"),
+        ("rail_limited", "<u4"),
+        ("wall_active", "<u4"),
+        ("secondary_suppressed", "<u4"),
+        ("ns_norm", "<f8"),
