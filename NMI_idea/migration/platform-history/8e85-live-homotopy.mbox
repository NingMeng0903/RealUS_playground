+N_TASK_SLACK = 6
+N_PREF_SLACK = 9  # [sigma, branch, J1..J7 comfort]
+MAX_PREF_ROWS = 16  # 1 sigma + 7 branch + 7 comfort
+# Backward-compatible alias used by older call sites / tests.
+N_SLACK = N_TASK_SLACK
