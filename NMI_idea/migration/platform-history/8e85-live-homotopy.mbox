+        ("dt_nom", "<f8"),
+        ("v_cmd", "<f8", (6,)),
+        ("q_meas", "<f8", (8,)),
+        ("rail_q", "<f8"),
+        ("rail_v", "<f8"),
+        ("v_force_z", "<f8"),
+        ("pose_d", "<f8", (6,)),
+        ("vel_ff", "<f8", (6,)),
+        ("qdot_ff", "<f8", (8,)),
+        ("path_twist", "<f8", (6,)),
+        ("feedback_twist", "<f8", (6,)),
+        ("cmd_f", "<f8", (16,)),
+        ("cmd_u", "<u4", (8,)),
+    ],
+    align=False,
+)
+
+WBC_OUT_DTYPE = np.dtype(
+    [
+        ("magic", "<u4"),
+        ("version", "<u4"),
+        ("seq", "<u8"),
+        ("cmd_ack", "<u8"),
+        ("status", "<u4"),
+        ("flags", "<u4"),
