+STYLE_RAIL_ONLY = 1
+STYLE_TCP_FIXED = 2
+
+WBC_IN_DTYPE = np.dtype(
+    [
+        ("magic", "<u4"),
+        ("version", "<u4"),
+        ("seq", "<u8"),
+        ("cmd_seq", "<u8"),
