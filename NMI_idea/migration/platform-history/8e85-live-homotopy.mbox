+OUT_WALL_ACTIVE = 1 << 2
+OUT_SEC_SUPPRESSED = 1 << 3
+OUT_STALE = 1 << 4
+OUT_READY = 1 << 5
+OUT_FAILED = 1 << 6
+
+STATUS_BOOT = 0
+STATUS_READY = 1
+STATUS_OK = 2
+STATUS_FAIL = 3
+STATUS_SHUTDOWN = 4
+
+RAIL_COUPLED = 0
+RAIL_LOCKED = 1
+STYLE_HOLD = 0
+STYLE_RAIL_ONLY = 1
+STYLE_TCP_FIXED = 2
+
+WBC_IN_DTYPE = np.dtype(
+    [
+        ("magic", "<u4"),
+        ("version", "<u4"),
+        ("seq", "<u8"),
+        ("cmd_seq", "<u8"),
+        ("cmd", "<u4"),
+        ("flags", "<u4"),
+        ("t_mono", "<f8"),
