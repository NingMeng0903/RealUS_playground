+    reg: [1.0e-3, 1.0e-2, 1.0e-2, 1.0e-2, 1.0e-2, 1.2e-2, 1.2e-2, 1.2e-2]
+    backend: proxqp
+    use_cpp_kernel: true
+    eps_abs: 1.0e-6
+    max_iter: 400
+    max_iter_cap: 400
+    max_solve_ms: 5.0
+    fail_qdot_decay: 0.85
+    twist_sigma_floor: 0.02
+    warn_on_fail: false
+    sr_damping:
+      lam0: 0.05
