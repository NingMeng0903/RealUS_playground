+                                    pose_pin, pt, inner.cfg.euler_order
+                                )
+                        except Exception:
+                            pass
+                        print(
+                            f"  ERROR: phase {phase.label!r} did not reach target "
+                            f"(t_ref={t_ref:.2f}s, wall={t_wall:.1f}s, "
+                            f"track={err_mm:.0f}mm, poseΔ={d_mm:.1f}mm/{d_deg:.1f}deg, "
+                            f"jq={jq:.1f}deg) "
+                            f"— safety stop",
+                            flush=True,
+                        )
