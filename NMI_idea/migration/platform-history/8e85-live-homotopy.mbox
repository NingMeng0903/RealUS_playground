+
+    def _step_impl(self, points: np.ndarray, *, timestamp_ns: int | None = None,
+                   rgb_phis=None, rgb_rotations=None, rgb_agreement=None,
+                   rgb_pelvis_world_m=None) -> dict:
+        import time
