+  double sigma_min;
+  double sigma_arm;
+  double cmd_f[8];
+  uint32_t joint_limited;
+  uint32_t rail_limited;
+  uint32_t wall_active;
+  uint32_t secondary_suppressed;
+  double ns_norm;
+  double ns_centering;
+  double ns_manip;
+  double ns_arm_angle;
+  double ns_damping;
+  double ns_rail_lock;
+  double sat_scale;
+  double sec_target_norm;
+  double homotopy_s;
+  double psi_star;
+  double rail_motion_share;
+  double u_task_raw;
+  double u_task_feasible;
