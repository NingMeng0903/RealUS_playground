+IN_STALE = 1 << 1
+IN_HAS_QDOT_FF = 1 << 2
+IN_HAS_POSE_D = 1 << 3
+IN_HAS_VEL_FF = 1 << 4
+IN_HAS_RAIL_V = 1 << 5
+IN_HAS_V_FORCE = 1 << 6
+IN_HAS_PATH_TWIST = 1 << 7
+IN_HAS_FEEDBACK_TWIST = 1 << 8
