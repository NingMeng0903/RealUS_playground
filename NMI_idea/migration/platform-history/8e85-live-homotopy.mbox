+            v_normal = self._force_barrier.clamp_velocity(
+                v_normal
+            )
+            v_normal = self._slew_force_normal(v_normal, dt_flow)
+            v_cmd_tool[2] = normal_sign * v_normal
+            if cfg.control_frame == "base":
+                v_cmd_base[:3] = r_mat @ v_cmd_tool[:3]
