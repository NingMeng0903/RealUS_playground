+            sec_target_norm=float(o["sec_target_norm"]),
+            homotopy_s=float(o["homotopy_s"]),
+            psi_star_deg=(
+                float(np.degrees(o["psi_star"]))
+                if np.isfinite(float(o["psi_star"]))
+                else float("nan")
+            ),
