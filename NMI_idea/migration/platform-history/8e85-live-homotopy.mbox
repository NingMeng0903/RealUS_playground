+  double cmd_f[16];
+  uint32_t cmd_u[8];
+};
+
+struct WbcOut {
+  uint32_t magic;
+  uint32_t version;
+  uint64_t seq;
+  uint64_t cmd_ack;
+  uint32_t status;
+  uint32_t flags;
