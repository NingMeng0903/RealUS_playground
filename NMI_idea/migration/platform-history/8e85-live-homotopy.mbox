+    v_lpf_fc_hz: 5.0
+    v_lpf_tau_escape_s: 0.04
+    # Narrow latch: deep σ or true near-limit only (healthy = FF + allocator).
+    sigma_escape_enter: 0.55
+    sigma_escape_exit: 0.80
