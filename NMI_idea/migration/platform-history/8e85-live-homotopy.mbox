+    / "assets"
+    / "robots"
+    / "rm75_6f_8dof"
+    / "RM75-6F-8dof.urdf"
+)
+
+RAIL_JOINT_NAME = "rail_y"
+ARM_JOINT_NAMES = [f"joint_{i}" for i in range(1, 8)]
+JOINT_NAMES = [RAIL_JOINT_NAME, *ARM_JOINT_NAMES]
+TCP_JOINT_NAME = "link_7_to_tcp"
