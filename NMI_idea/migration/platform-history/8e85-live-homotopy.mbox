+            matrices[:, active] = rotation_6d_to_matrix(parameters)
+            vertices = self._refinement_vertices(matrices)
+            landmarks = torch.einsum("jv,bvc->bjc", self.landmark_regressor, vertices) + root[:, None]
+            residual = landmarks - target
