+  recontact_hold_s: 0.80
+  recontact_settle_m_s: 0.003
+  recontact_settle_hold_s: 0.050
+  contact_episode_release_s: 0.80
+  contact_episode_release_force_n: 0.75
+  # Slow DC chase.  Must stay well below CDYOB Q (0.75 Hz).  034244
