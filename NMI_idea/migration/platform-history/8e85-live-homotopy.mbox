+Vec6 twist_to_base(const Vec6& twist, const Eigen::Matrix3d& R, bool tool) {
+  if (!tool) return twist;
+  Vec6 out;
+  out.head<3>() = R * twist.head<3>();
+  out.tail<3>() = R * twist.tail<3>();
+  return out;
+}
