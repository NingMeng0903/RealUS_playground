+    class FakeBus:
+        last_rail_m = 0.125
+
+        def read(self):
+            return SimpleNamespace(
+                ok=True,
+                seq=17,
+                wall_time_ns=123456789,
+                t_s=4.5,
+                q_deg=np.array([0.0, 90.0, -90.0, 180.0, 45.0, 0.0, -45.0]),
