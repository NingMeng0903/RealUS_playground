+                "pose_boxes": _boxes_metadata(resolved),
+                "detector_box_count": int(real.shape[0]),
+                "detector_miss": detector_miss,
+                "association_miss": association_miss,
+                "association_iou": association_iou,
+                "bbox_source": source,
+            }
+        )
+    return pose_boxes, diagnostics
+
