+            print(
+                f"[FIT] refit without {len(rejected)} poses  "
+                f"inliers {len(kept)}/{len(windows)}  limit={limit_n:.2f} N",
+                flush=True,
+            )
+            windows = kept
+        else:
+            print(
+                f"[FIT] {len(rejected)} poses exceed {limit_n:.2f} N but too few inliers remain",
