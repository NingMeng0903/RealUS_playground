+Layouts must match ``native/wbc_rt/include/wbc_rt/protocol.hpp``.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+WBC_MAGIC = 0x57424331
+WBC_VERSION = 4
+DEFAULT_IN_NAME = "rm75_wbc_in"
+DEFAULT_OUT_NAME = "rm75_wbc_out"
+
+CMD_NONE = 0
+CMD_STEP = 1
