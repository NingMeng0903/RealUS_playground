+def _parse_nullspace(inner: dict) -> tuple[NullspaceTaskConfig, ManipulabilityTaskConfig]:
+    n = _mapping(inner.get("nullspace"), name="inner.nullspace")
+    _reject_unknown(
+        n,
+        {
+            "k_center", "k_limit", "activation", "weights", "q_nominal_deg",
+            "manipulability",
