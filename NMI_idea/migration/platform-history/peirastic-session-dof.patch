+        total.commit(v, dt)
+        assert abs(mix.xi) < 1e-12
+        assert tel.u_post_committed == pytest.approx(0, abs=1e-12)
+        xi = mix.xi
+        mix.commit_final(99, -99, dt)  # one integration per committed tick
+        assert mix.xi == xi
