+        model_path, model_sha = require_frozen_smplx_male_v7(args.smplx_model)
+        model = load_smplx_model_v7(model_path)
+        captures = {
+            "213328": args.capture_213328.expanduser().resolve(),
+            "213712": args.capture_213712.expanduser().resolve(),
