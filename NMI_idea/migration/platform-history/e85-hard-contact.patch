+                                last_feedback_t = snap_t
+                                last_feedback_q = q_new.copy()
+                            q_meas = q_new
+                            pose_pin = inner.kin.fk_pose(q_meas)
+
+                        sensor_age_s = (
+                            max(0.0, time.monotonic() - float(snap.t_s))
+                            if float(getattr(snap, "t_s", 0.0)) > 0.0
