+        ),
+        capture_sha256=str(
+            manifest.get("capture_sha256") or build_report.get("capture_sha256", "")
+        ),
+        subject_label=str(manifest["subject_label"]),
+        betas=np.asarray(arrays["betas"], dtype=np.float64),
