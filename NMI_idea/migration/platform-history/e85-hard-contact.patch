@@ -0,0 +1,407 @@
+"""Focused tests for the standalone hard-contact energy guard."""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from rm75_control.control.admittance_common.hard_contact_energy_guard import (
+    HardContactEnergyGuard,
+    HardContactEnergyGuardConfig,
+)
+
+
+DT = 0.005
+
+
+def _guard(**kwargs) -> HardContactEnergyGuard:
+    cfg = HardContactEnergyGuardConfig(enabled=True, **kwargs)
+    return HardContactEnergyGuard(cfg)
+
+
+def _tick(
+    guard: HardContactEnergyGuard,
+    v: float = 0.02,
+    *,
+    f: float = 2.0,
+    fd: float = 2.0,
+    fp: float = 2.0,
+    fdot: float = 0.0,
+    dx: float = 0.0,
+    fresh: bool = False,
+    dt: float = DT,
+    contact: bool = True,
+) -> float:
+    return guard.step(
+        v_cmd_m_s=v,
+        f_ext_z=f,
+        f_des_z=fd,
+        f_pred_z=fp,
+        f_dot_z=fdot,
+        dx_tool_z_m=dx,
+        dx_fresh=fresh,
+        dt_s=dt,
+        contact_present=contact,
+    )
+
+
+def _enter_danger(guard: HardContactEnergyGuard) -> None:
+    _tick(guard, fp=2.16, f=2.0, contact=True)
+    assert guard.danger_active
+    assert guard.last_danger_entered
+
+
+def _update(
+    guard: HardContactEnergyGuard,
+    *,
+    f: float = 2.0,
+    fd: float = 2.0,
+    fp: float = 2.0,
+    fdot: float = 0.0,
+    latched: bool = True,
+    contact: bool = True,
+    compressing: bool = False,
+    dx: float | None = 0.0,
+    fresh: bool = True,
+    dt: float = DT,
+    feedback_dt: float | None = None,
+    press_v: float = 0.02,
+) -> float:
+    return guard.update(
+        f_ext_z=f,
+        desired_force_n=fd,
+        force_pred_n=fp,
+        force_dot_n_s=fdot,
+        force_task_latched=latched,
+        physical_contact=contact,
+        compressing_actual=compressing,
+        actual_dx_m=dx,
+        feedback_fresh=fresh,
+        dt_s=dt,
+        press_velocity_m_s=press_v,
+        feedback_dt_s=feedback_dt,
+    )
+
+
+def test_defaults_are_disabled_and_budget_matches_plan() -> None:
+    cfg = HardContactEnergyGuardConfig()
+    assert cfg.enabled is False
+    assert cfg.e_initial_j == pytest.approx(0.001)
+    assert cfg.e_max_j == pytest.approx(0.004)
+    assert cfg.credit_gain == pytest.approx(0.20)
+    assert cfg.dx_residual_m == pytest.approx(2.0e-6)
+    assert cfg.danger_fpred_over_n == pytest.approx(0.15)
+    assert cfg.danger_fdot_n_s == pytest.approx(5.0)
+    assert cfg.danger_f_over_fdot_n == pytest.approx(0.10)
+    assert cfg.safe_confirm_s == pytest.approx(0.025)
+
+
+def test_from_dict_matches_controller_yaml_contract() -> None:
+    cfg = HardContactEnergyGuardConfig.from_dict(
+        {
+            "hybrid_motion": {
+                "hard_contact_energy_guard": {
+                    "enabled": True,
+                    "e_initial_j": 0.002,
+                    "dx_deadband_m": 3.0e-6,
+                    "danger_over_n": 0.2,
+                    "safe_over_n": 0.3,
+                }
+            }
+        }
+    )
+    assert cfg.enabled is True
+    assert cfg.e_initial_j == pytest.approx(0.002)
+    assert cfg.dx_deadband_m == pytest.approx(3.0e-6)
+    assert cfg.danger_over_n == pytest.approx(0.2)
+    assert cfg.safe_over_n == pytest.approx(0.3)
+
+
+def test_disabled_is_exact_pass_through_and_does_not_consume() -> None:
+    guard = HardContactEnergyGuard()
+    before = guard.energy_j
+    value = -0.0
+    out = _tick(guard, value, fp=20.0, fdot=100.0, dx=0.01, fresh=True)
+    assert math.copysign(1.0, out) == -1.0
+    assert out == value
+    assert guard.energy_j == before
+    assert not guard.danger_active
+
+
+def test_non_danger_is_exact_pass_through() -> None:
+    guard = _guard()
+    value = 0.03125
+    out = _tick(guard, value, fp=2.14, fdot=0.0)
+    assert out == value
+    assert guard.gamma == pytest.approx(1.0)
+    assert not guard.danger_active
+
+
+def test_danger_entry_supports_both_approved_signals() -> None:
+    by_prediction = _guard()
+    _tick(by_prediction, fp=2.151, f=2.0, fdot=0.0)
+    assert by_prediction.danger_active
+
+    by_slope = _guard()
+    _tick(by_slope, fp=2.0, f=2.101, fdot=5.001)
+    assert by_slope.danger_active
+
+
+def test_slope_signal_requires_force_over_target_margin() -> None:
+    guard = _guard()
+    _tick(guard, fp=2.0, f=2.099, fdot=100.0)
+    assert not guard.danger_active
+
+
+def test_entry_is_contact_qualified_but_latch_survives_loss() -> None:
+    guard = _guard()
+    _tick(guard, fp=2.2, contact=False)
+    assert not guard.danger_active
+    _enter_danger(guard)
+    _tick(guard, fp=2.0, contact=False, dt=0.100)
+    assert guard.danger_active
+    assert guard.safe_timer_s == pytest.approx(0.0)
+
+
+def test_update_contract_exposes_controller_telemetry_aliases() -> None:
+    guard = _guard()
+    gamma = _update(guard, fp=2.2, dx=0.0, fresh=True)
+    assert 0.0 <= gamma <= 1.0
+    assert guard.danger_latched
+    assert guard.last_feedback_fresh
+    assert guard.last_dx_m == pytest.approx(0.0)
+    assert guard.last_work_j == pytest.approx(0.0)
+    assert guard.last_requested_j > 0.0
+
+
+def test_safe_confirmation_requires_25ms_after_recontact() -> None:
+    guard = _guard()
+    _enter_danger(guard)
+    _tick(guard, fp=2.0, contact=True, fresh=True, dt=0.020)
+    assert guard.danger_active
+    _tick(guard, fp=2.0, contact=True, fresh=True, dt=0.005)
+    assert not guard.danger_active
+    assert guard.last_danger_cleared
+
+
+def test_danger_rearms_confirmation_when_signal_returns() -> None:
+    guard = _guard()
+    _enter_danger(guard)
+    _tick(guard, fp=2.0, contact=True, fresh=True, dt=0.020)
+    _tick(guard, fp=2.2, contact=True, dt=0.005)
+    assert guard.danger_active
+    assert guard.safe_timer_s == pytest.approx(0.0)
+
+
+def test_safe_confirmation_rejects_continued_actual_compression() -> None:
+    guard = _guard()
+    _update(guard, fp=2.2, fresh=False)
+    for _ in range(10):
+        _update(
+            guard,
+            fp=2.0,
+            fdot=-1.0,
+            compressing=True,
+            fresh=False,
+        )
+    assert guard.danger_latched
+    assert guard.safe_timer_s == pytest.approx(0.0)
+
+
+def test_negative_velocity_is_unchanged_even_when_tank_empty() -> None:
+    guard = _guard()
+    _enter_danger(guard)
+    guard.energy_j = 0.0
+    value = -0.0375
+    out = _tick(guard, value, fp=2.2, dx=0.0, fresh=False)
+    assert out == value
+    assert guard.gamma == pytest.approx(1.0)
+
+
+def test_fresh_actual_dx_is_the_only_work_source() -> None:
+    guard = _guard()
+    _enter_danger(guard)
+    initial = guard.energy_j
+    _tick(guard, fp=2.2, dx=0.01, fresh=False)
+    assert guard.energy_j == pytest.approx(initial)
+    assert guard.last_work_j == pytest.approx(0.0)
+    _tick(guard, fp=2.2, dx=0.001, fresh=True)
+    assert guard.last_work_j > 0.0
+    assert guard.energy_j < initial
+
+
+def test_two_micrometer_residual_accumulates_fresh_steps() -> None:
