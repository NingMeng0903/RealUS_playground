+            for name, report in {"rest_fit": rest_report, **hard_reports}.items():
+                _write_json(temporary / f"subject_{label}_{name}_check.json", report)
+            improve_cell = improve_report["cells"]["pose_213328"]
+            subjects[label] = {
+                "path": f"subject_{label}",
+                "passed": True,
