+
+def _render_slim(
+    *,
+    label: str,
+    value: Any,
+    asset: Any,
+    output: Path,
+    operator: Any,
+    calibration: Any,
+    model: Any,
+    oracle: Path,
+    betas: np.ndarray,
+    pose: np.ndarray,
+    backend: str,
+    custom_asset: Any | None = None,
+) -> dict[str, Any]:
+    use_asset = custom_asset if custom_asset is not None else asset
+    pose_map = build_pose_map_v1(
