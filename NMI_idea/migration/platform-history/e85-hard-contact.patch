+def test_residual_power_is_observed_while_danger_budget_bounds_all_press() -> None:
+    guard = _guard()
+    _update(guard, fp=2.2, fresh=False)
+    guard.energy_j = 0.0
+
+    # Perfectly achieved press has no proxy/robot velocity residual.  During a
+    # confirmed danger episode, however, an empty tank still closes new press
+    # energy; this covers force-sensor phase lag outside the paper's residual.
+    gamma_following = _update(
+        guard,
+        fp=2.2,
+        dx=0.02 * DT,
+        fresh=True,
+        press_v=0.02,
+    )
+    assert gamma_following == pytest.approx(0.0)
+    assert guard.last_velocity_residual_m_s == pytest.approx(0.0)
+
+    # A stuck TCP turns the same press command into positive residual power.
+    gamma_stuck = _update(
+        guard,
+        fp=2.2,
+        dx=0.0,
+        fresh=True,
+        press_v=0.02,
+    )
+    assert gamma_stuck == pytest.approx(0.0)
+    assert guard.last_residual_power_w > 0.0
+    assert guard.last_requested_j > 0.0
+
