+        config: AdmittanceConfig | None = None,
+    ) -> None:
+        self.dt = dt
+        self.cfg = config or AdmittanceConfig()
+        # A fixed identifier is retained in CSV logs; it is not a mode switch.
+        self.controller_mode = "legacy_symmetric"
