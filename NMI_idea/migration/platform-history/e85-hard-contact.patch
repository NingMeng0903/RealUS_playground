+@pytest.mark.parametrize(
+    ("held_s", "expected_gamma"),
+    [
+        (0.005, 1.0),
+        (0.010, 1.0),
+        (0.020, 0.0),
+        (0.045, 0.0),
+        (0.055, 0.0),
+    ],
+)
+def test_held_feedback_closes_press_after_short_grace(
+    held_s: float,
+    expected_gamma: float,
+) -> None:
+    guard = _guard(feedback_timeout_s=0.015)
+    _update(guard, fp=2.2, dx=0.0, fresh=True, press_v=0.02)
+    elapsed = 0.0
+    gamma = 1.0
+    while elapsed + 1.0e-12 < held_s:
+        gamma = _update(
+            guard,
+            fp=2.2,
+            dx=0.5,
+            fresh=False,
+            press_v=0.02,
+        )
+        elapsed += DT
+    assert gamma == pytest.approx(expected_gamma)
+    assert guard.energy_j >= 0.0
+    assert guard.last_work_j == pytest.approx(0.0)
+    assert guard.last_requested_j == pytest.approx(0.0)
+
