+        dx_m: float,
+        u_press: float,
+        v_press_est_m_s: float,
+        dt_s: float,
+    ) -> float:
+        """Credit/debit tank; return γ ∈ [0, 1] for active press scaling."""
+        cfg = self.cfg
+        if not cfg.enabled:
+            self.gamma = 1.0
+            return 1.0
+
+        f = float(f_ext_z)
+        dx = self._consume_dx(dx_m)
+        f_prev = self._f_prev if self._f_prev == self._f_prev else f
+        f_mid = 0.5 * (f + float(f_prev))
+        self._f_prev = f
