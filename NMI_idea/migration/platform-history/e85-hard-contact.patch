+def test_duplicate_feedback_adds_zero_energy_and_holds_active_scale() -> None:
+    guard = _guard()
+    _update(guard, fp=2.2, fresh=False)
+    guard.energy_j = 0.0
+    assert _update(guard, fp=2.2, dx=0.0, fresh=True) == pytest.approx(0.0)
+    before = guard.energy_j
+    gamma = _update(guard, fp=2.2, dx=0.5, fresh=False)
+    assert gamma == pytest.approx(0.0)
+    assert guard.energy_j == pytest.approx(before)
+    assert guard.last_work_j == pytest.approx(0.0)
+    assert guard.last_requested_j == pytest.approx(0.0)
+    assert not guard.last_feedback_fresh
+
