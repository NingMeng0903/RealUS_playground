+"""Integration guards for the e85 force core and hard-contact modulation."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from pathlib import Path
+
+import numpy as np
+import pytest
+import yaml
+
+from rm75_control.control.admittance_common.controller import (
+    AdmittanceConfig,
+    AdmittanceController,
+)
+
+
+DT = 0.005
+
+
+def _config(*, guard_enabled: bool) -> AdmittanceConfig:
+    raw = yaml.safe_load(
+        Path("configs/joint_admittance_8dof.yaml").read_text(encoding="utf-8")
+    )
+    cfg = AdmittanceConfig.from_dict(raw)
+    cfg.hard_contact_energy_guard.enabled = guard_enabled
+    return cfg
+
+
+def _tick(
+    controller: AdmittanceController,
+    *,
+    filtered_force_n: float,
+    desired_force_n: float,
+    raw_force_n: float | None = None,
+    actual_dx_m: float = 0.0,
+    feedback_fresh: bool = True,
+    feedback_dt_s: float = DT,
+) -> float:
+    pose = np.zeros(6)
+    force = np.zeros(6)
+    force[2] = filtered_force_n
+    raw = np.zeros(6)
+    raw[2] = filtered_force_n if raw_force_n is None else raw_force_n
+    desired = np.zeros(6)
+    desired[2] = desired_force_n
+    return float(
+        controller.compute_velocity_command(
+            pose,
+            pose,
+            np.zeros(6),
+            force,
+            desired,
+            in_contact=True,
+            f_ext_raw=raw,
+            dt_actual=DT,
+            v_tcp_z_actual=actual_dx_m / feedback_dt_s,
+            actual_dx_tcp_z_m=actual_dx_m,
+            feedback_fresh=feedback_fresh,
+            feedback_dt_s=feedback_dt_s,
+        )[2]
+    )
+
+
+def test_enabled_but_inactive_guard_is_bit_exact_e85() -> None:
+    baseline = AdmittanceController(DT, _config(guard_enabled=False))
+    guarded_cfg = deepcopy(_config(guard_enabled=True))
+    guarded = AdmittanceController(DT, guarded_cfg)
+
+    baseline_trace: list[tuple[float, float, float, float, float]] = []
+    guarded_trace: list[tuple[float, float, float, float, float]] = []
+    for _ in range(300):
+        baseline_v = _tick(
+            baseline,
+            filtered_force_n=0.9,
+            desired_force_n=1.5,
+        )
+        guarded_v = _tick(
+            guarded,
+            filtered_force_n=0.9,
+            desired_force_n=1.5,
+        )
+        baseline_trace.append(
+            (
+                baseline_v,
+                baseline.v_r_z,
+                baseline.u_dob_z,
+                baseline.damping_z_eff,
+                baseline.v_force_z,
+            )
+        )
+        guarded_trace.append(
+            (
+                guarded_v,
+                guarded.v_r_z,
+                guarded.u_dob_z,
+                guarded.damping_z_eff,
+                guarded.v_force_z,
+            )
+        )
+
+    assert np.array_equal(np.asarray(guarded_trace), np.asarray(baseline_trace))
+    assert not guarded.hard_contact_guard_active
+    assert guarded.hard_contact_guard_gamma == pytest.approx(1.0)
+    assert guarded.v_r_z > 0.0
+    assert guarded.u_dob_z > 0.0
+    assert guarded_trace[-1][0] > 0.010
+
+
+def test_danger_modulates_press_but_not_nominal_e85_components() -> None:
+    baseline = AdmittanceController(DT, _config(guard_enabled=False))
+    guarded = AdmittanceController(DT, _config(guard_enabled=True))
+
+    for _ in range(80):
+        _tick(baseline, filtered_force_n=0.9, desired_force_n=1.5)
+        _tick(guarded, filtered_force_n=0.9, desired_force_n=1.5)
+
+    guarded._hard_contact_guard.energy_j = 0.0
+    for _ in range(2):
+        baseline_v = _tick(
+            baseline,
+            filtered_force_n=0.9,
+            raw_force_n=2.2,
+            desired_force_n=1.5,
+            actual_dx_m=0.0,
+        )
+        guarded_v = _tick(
+            guarded,
+            filtered_force_n=0.9,
+            raw_force_n=2.2,
+            desired_force_n=1.5,
+            actual_dx_m=0.0,
+        )
+
+    assert baseline_v > 0.0
+    assert guarded.hard_contact_guard_active
+    assert guarded.hard_contact_guard_gamma < 0.02
+    assert guarded_v < 0.02 * baseline_v
+    assert guarded.v_r_z == pytest.approx(baseline.v_r_z)
+    assert guarded.u_dob_z == pytest.approx(baseline.u_dob_z)
+    assert guarded.damping_z_eff == pytest.approx(baseline.damping_z_eff)
+
+
+def test_danger_retract_is_exactly_unchanged() -> None:
+    baseline = AdmittanceController(DT, _config(guard_enabled=False))
+    guarded = AdmittanceController(DT, _config(guard_enabled=True))
+
+    for _ in range(20):
+        _tick(baseline, filtered_force_n=1.5, desired_force_n=1.5)
+        _tick(guarded, filtered_force_n=1.5, desired_force_n=1.5)
+    guarded._hard_contact_guard.energy_j = 0.0
+
+    baseline_v = _tick(
+        baseline,
+        filtered_force_n=2.2,
+        raw_force_n=2.2,
+        desired_force_n=1.5,
+        actual_dx_m=-1.0e-5,
+    )
+    guarded_v = _tick(
+        guarded,
+        filtered_force_n=2.2,
+        raw_force_n=2.2,
+        desired_force_n=1.5,
+        actual_dx_m=-1.0e-5,
+    )
+
+    assert guarded.hard_contact_guard_active
+    assert baseline_v < 0.0
+    assert guarded_v == baseline_v
+
+
+def test_feedback_interval_reaches_controller_guard_telemetry() -> None:
+    guarded = AdmittanceController(DT, _config(guard_enabled=True))
+    for _ in range(2):
+        _tick(
+            guarded,
+            filtered_force_n=0.9,
+            raw_force_n=2.2,
+            desired_force_n=1.5,
+            actual_dx_m=2.0e-4,
+            feedback_dt_s=0.010,
+        )
+    assert guarded.hard_contact_guard_active
+    assert guarded.hard_contact_guard_actual_velocity_m_s == pytest.approx(0.02)
