+        self._hp_zi = np.zeros(
+            max(len(self._hp_a), len(self._hp_b)) - 1,
+            dtype=np.float64,
+        )
+        self._is_energy_alpha = (
+            float(min(1.0, self.dt / 0.2)) if self.dt > 0 else 0.05
+        )
