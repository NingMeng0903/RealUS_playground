+        encoding="utf-8",
+    )
+    keep = args.keep_set.expanduser().resolve()
+    if keep.exists():
+        shutil.rmtree(keep)
+    keep.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copytree(output / "slim", keep)
