+    )
+    parser.add_argument(
+        "--v7-shadow",
+        type=Path,
+        default=Path("outputs/anatomy_retarget/v8_candidates/chain_retarget_v7_node2_001"),
+    )
+    parser.add_argument(
+        "--v8-shadow",
