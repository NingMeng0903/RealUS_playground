@@ -0,0 +1,454 @@
+"""Hard-contact-only press energy guard for the e85 force core.
+
+The guard sits after the nominal controller.  It is exactly neutral until a
+hard-contact danger signal is latched, and it can scale only positive tool-Z
+press velocity.  Retract is never modified.
+
+Energy observations use fresh encoder displacement only.  A repeated feedback
+frame contributes neither port work nor command-tracking residual energy.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+
+
+@dataclass
+class HardContactEnergyGuardConfig:
+    """Configuration for :class:`HardContactEnergyGuard`."""
+
+    enabled: bool = False
+    e_initial_j: float = 0.001
+    e_max_j: float = 0.004
+    e_min_j: float = 0.0
+    credit_gain: float = 0.20
+    dx_deadband_m: float = 2.0e-6
+    leak_s: float = 0.5
+    danger_over_n: float = 0.15
+    danger_fdot_n_s: float = 5.0
+    danger_over_fdot_n: float = 0.10
+    safe_over_n: float = 0.25
+    safe_confirm_s: float = 0.025
+    feedback_timeout_s: float = 0.015
+
+    # Constructor aliases retained for the standalone draft and replay tools.
+    dx_residual_m: float | None = None
+    danger_fpred_over_n: float | None = None
+    danger_f_over_fdot_n: float | None = None
+
+    def __post_init__(self) -> None:
+        if self.dx_residual_m is not None:
+            self.dx_deadband_m = float(self.dx_residual_m)
+        else:
+            self.dx_residual_m = float(self.dx_deadband_m)
+        if self.danger_fpred_over_n is not None:
+            self.danger_over_n = float(self.danger_fpred_over_n)
+        else:
+            self.danger_fpred_over_n = float(self.danger_over_n)
+        if self.danger_f_over_fdot_n is not None:
+            self.danger_over_fdot_n = float(self.danger_f_over_fdot_n)
+        else:
+            self.danger_f_over_fdot_n = float(self.danger_over_fdot_n)
+
+    @property
+    def dx_deadband(self) -> float:
+        """Readable compatibility alias for the displacement threshold."""
+
+        return float(self.dx_deadband_m)
+
+    @classmethod
+    def from_dict(cls, raw: dict) -> HardContactEnergyGuardConfig:
+        """Load the nested controller configuration, using inert defaults."""
+
+        c = raw.get("hybrid_motion", raw.get("controller", raw))
+        p = c.get("hard_contact_energy_guard", {}) if isinstance(c, dict) else {}
+        if not isinstance(p, dict):
+            p = {}
+        return cls(
+            enabled=bool(p.get("enabled", False)),
+            e_initial_j=float(p.get("e_initial_j", 0.001)),
+            e_max_j=float(p.get("e_max_j", 0.004)),
+            e_min_j=float(p.get("e_min_j", 0.0)),
+            credit_gain=float(p.get("credit_gain", 0.20)),
+            dx_deadband_m=float(
+                p.get("dx_deadband_m", p.get("dx_residual_m", 2.0e-6))
+            ),
+            leak_s=float(p.get("leak_s", 0.5)),
+            danger_over_n=float(
+                p.get("danger_over_n", p.get("danger_fpred_over_n", 0.15))
+            ),
+            danger_fdot_n_s=float(p.get("danger_fdot_n_s", 5.0)),
+            danger_over_fdot_n=float(
+                p.get(
+                    "danger_over_fdot_n",
+                    p.get("danger_f_over_fdot_n", 0.10),
+                )
+            ),
+            safe_over_n=float(p.get("safe_over_n", 0.25)),
+            safe_confirm_s=float(p.get("safe_confirm_s", 0.025)),
+            feedback_timeout_s=float(p.get("feedback_timeout_s", 0.015)),
+        )
+
+
+class HardContactEnergyGuard:
+    """Latched hard-contact budget that returns a press scale in ``[0, 1]``."""
+
+    def __init__(self, cfg: HardContactEnergyGuardConfig | None = None) -> None:
+        self.cfg = cfg or HardContactEnergyGuardConfig()
+        self.reset()
+
+    def reset(self) -> None:
+        """Reset the phase-level budget and danger state."""
+
+        self.energy_j = self._clamp_energy(float(self.cfg.e_initial_j))
+        self.gamma = 1.0
+        self.danger_latched = False
+        self.safe_timer_s = 0.0
+        self.last_danger_entered = False
+        self.last_danger_cleared = False
+        self.last_feedback_fresh = False
+        self.last_dx_m = 0.0
+        self.last_work_j = 0.0
+        self.last_requested_j = 0.0
+        self.last_residual_power_w = 0.0
+        self.last_velocity_residual_m_s = 0.0
+        self.last_actual_velocity_m_s = 0.0
+        self.feedback_age_s = float("inf")
+        self.feedback_timed_out = True
+        self.last_f_pred_z = float("nan")
+        self.last_f_dot_z = float("nan")
+        self.last_f_ext_z = float("nan")
+        self._f_prev = float("nan")
+        self._dx_residual_m = 0.0
+
+    @property
+    def danger_active(self) -> bool:
+        """Compatibility alias for older standalone callers."""
+
+        return bool(self.danger_latched)
+
+    @property
+    def last_dx_used_m(self) -> float:
+        """Compatibility alias for older standalone telemetry."""
+
+        return float(self.last_dx_m)
+
+    def on_reacquire(self) -> None:
+        """Do not refill the tank or clear danger on contact reacquisition."""
+
+        return None
+
+    def _clamp_energy(self, value: float) -> float:
+        e_min = float(self.cfg.e_min_j)
+        e_max = max(float(self.cfg.e_max_j), e_min)
+        if not math.isfinite(value):
+            return e_min
+        return min(max(float(value), e_min), e_max)
+
+    def _clear_tick_telemetry(self, feedback_fresh: bool = False) -> None:
+        self.last_feedback_fresh = bool(feedback_fresh)
+        self.last_dx_m = 0.0
+        self.last_work_j = 0.0
+        self.last_requested_j = 0.0
+        self.last_residual_power_w = 0.0
+        self.last_velocity_residual_m_s = 0.0
+        self.last_actual_velocity_m_s = 0.0
+
+    def _danger_update(
+        self,
+        *,
+        f_ext_z: float,
+        desired_force_n: float,
+        force_pred_n: float,
+        force_dot_n_s: float,
+        force_task_latched: bool,
+        physical_contact: bool,
+        compressing_actual: bool,
+        feedback_valid: bool,
+        dt_s: float,
+    ) -> None:
+        """Update the contact-qualified danger latch."""
+
+        self.last_danger_entered = False
+        self.last_danger_cleared = False
+        self.last_f_ext_z = float(f_ext_z)
+        self.last_f_pred_z = float(force_pred_n)
+        self.last_f_dot_z = float(force_dot_n_s)
+
+        signals_finite = all(
+            math.isfinite(value)
+            for value in (f_ext_z, desired_force_n, force_pred_n, force_dot_n_s)
+        )
+        over_pred = signals_finite and (
+            float(force_pred_n)
+            > float(desired_force_n) + float(self.cfg.danger_over_n)
+        )
+        rising_over = signals_finite and (
+            float(force_dot_n_s) > float(self.cfg.danger_fdot_n_s)
+            and float(f_ext_z)
+            > float(desired_force_n) + float(self.cfg.danger_over_fdot_n)
+        )
+        danger_signal = bool(over_pred or rising_over)
+        danger_entry = bool(
+            force_task_latched and physical_contact and danger_signal
+        )
+
+        if not self.danger_latched:
+            self.safe_timer_s = 0.0
+            if danger_entry:
+                self.danger_latched = True
+                self.last_danger_entered = True
+                self._f_prev = float("nan")
+                self._dx_residual_m = 0.0
+            return
+
+        # Contact loss and invalid force data are never treated as proof that
+        # the hard-contact episode is safe.
+        safe_now = bool(
+            force_task_latched
+            and physical_contact
+            and signals_finite
+            and feedback_valid
+            and not compressing_actual
+            and float(force_dot_n_s) <= 0.0
+            and float(force_pred_n)
+            <= float(desired_force_n) + float(self.cfg.safe_over_n)
+            and not danger_signal
+        )
+        if not safe_now:
+            self.safe_timer_s = 0.0
+            return
+
+        dt = float(dt_s) if math.isfinite(dt_s) else 0.0
+        self.safe_timer_s += max(dt, 0.0)
+        if self.safe_timer_s + 1.0e-12 < max(
+            float(self.cfg.safe_confirm_s), 0.0
+        ):
+            return
+        self.danger_latched = False
+        self.safe_timer_s = 0.0
+        self.last_danger_cleared = True
+        self._f_prev = float("nan")
+        self._dx_residual_m = 0.0
+
+    def _consume_dx(self, dx_m: float) -> float:
+        self._dx_residual_m += float(dx_m)
+        deadband = max(float(self.cfg.dx_deadband_m), 0.0)
+        if abs(self._dx_residual_m) < deadband:
+            return 0.0
+        dx_used = float(self._dx_residual_m)
+        self._dx_residual_m = 0.0
+        return dx_used
+
+    def _observe_fresh_feedback(
+        self,
+        *,
+        f_ext_z: float,
+        actual_dx_m: float,
+        feedback_dt_s: float,
+        command_dt_s: float,
+        press_velocity_m_s: float,
+    ) -> float:
+        """Account one fresh sample and return the next press-energy request."""
+
+        f_now = float(f_ext_z)
+        dx_raw = float(actual_dx_m)
+        feedback_dt = max(float(feedback_dt_s), 0.0)
+        command_dt = max(float(command_dt_s), 0.0)
+        dx_used = self._consume_dx(dx_raw)
+        f_prev = self._f_prev if math.isfinite(self._f_prev) else f_now
+        f_mid = 0.5 * (f_prev + f_now)
+        self._f_prev = f_now
+
+        work_j = f_mid * dx_used
+        self.last_dx_m = float(dx_used)
+        self.last_work_j = float(work_j)
+        if work_j > 0.0:
+            self.energy_j -= work_j
+        elif work_j < 0.0 and f_mid > 0.0:
+            self.energy_j += (-work_j) * max(float(self.cfg.credit_gain), 0.0)
+        self.energy_j = self._clamp_energy(self.energy_j)
+
+        if feedback_dt <= 0.0 or command_dt <= 0.0:
+            return 0.0
+        actual_velocity = dx_raw / feedback_dt
+        press_velocity = max(float(press_velocity_m_s), 0.0)
+        velocity_residual = (
+            max(press_velocity - actual_velocity, 0.0)
+            if press_velocity > 0.0
+            else 0.0
+        )
+        residual_power = max(f_now, 0.0) * velocity_residual
+        requested_j = max(f_now, 0.0) * press_velocity * command_dt
+        self.last_actual_velocity_m_s = float(actual_velocity)
+        self.last_velocity_residual_m_s = float(velocity_residual)
+        self.last_residual_power_w = float(residual_power)
+        self.last_requested_j = float(requested_j)
+        return float(requested_j)
+
+    def _relax_energy(self, dt_s: float) -> None:
+        """Slowly return a safe, inactive tank toward its initial level."""
+
+        dt = float(dt_s) if math.isfinite(dt_s) else 0.0
+        leak = max(float(self.cfg.leak_s), 0.0)
+        if dt <= 0.0 or leak <= 0.0:
+            return
+        target = self._clamp_energy(float(self.cfg.e_initial_j))
+        blend = 1.0 - math.exp(-leak * dt)
+        self.energy_j = self._clamp_energy(
+            self.energy_j + (target - self.energy_j) * blend
+        )
+
+    def update(
+        self,
+        *,
+        f_ext_z: float,
+        desired_force_n: float,
+        force_pred_n: float,
+        force_dot_n_s: float,
+        force_task_latched: bool,
+        physical_contact: bool,
+        compressing_actual: bool,
+        actual_dx_m: float | None,
+        feedback_fresh: bool,
+        dt_s: float,
+        press_velocity_m_s: float,
+        feedback_dt_s: float | None = None,
+    ) -> float:
+        """Observe one tick and return the positive-press multiplier.
+
+        A fresh sample spends the tank only while danger is latched.  Proxy to
+        robot residual power is observed as in bidirectional-energy-flow
+        analysis, while the finite tank bounds the complete positive press
+        request.  Outside danger, normal e85 force recovery is exactly neutral.
+        """
+
+        if not bool(self.cfg.enabled):
+            self.gamma = 1.0
+            return 1.0
+
+        valid_feedback = bool(
+            feedback_fresh
+            and actual_dx_m is not None
+            and math.isfinite(float(actual_dx_m))
+        )
+        dt = float(dt_s) if math.isfinite(float(dt_s)) else 0.0
+        feedback_dt = (
+            float(feedback_dt_s)
+            if feedback_dt_s is not None and math.isfinite(float(feedback_dt_s))
+            else dt
+        )
+        valid_feedback = bool(valid_feedback and feedback_dt > 0.0)
+        if valid_feedback:
+            self.feedback_age_s = 0.0
+        elif math.isfinite(self.feedback_age_s):
+            self.feedback_age_s += max(dt, 0.0)
+        self.feedback_timed_out = bool(
+            not math.isfinite(self.feedback_age_s)
+            or self.feedback_age_s
+            >= max(float(self.cfg.feedback_timeout_s), 0.0)
+        )
+        self._clear_tick_telemetry(valid_feedback)
+        self._danger_update(
+            f_ext_z=float(f_ext_z),
+            desired_force_n=float(desired_force_n),
+            force_pred_n=float(force_pred_n),
+            force_dot_n_s=float(force_dot_n_s),
+            force_task_latched=bool(force_task_latched),
+            physical_contact=bool(physical_contact),
+            compressing_actual=bool(compressing_actual),
+            feedback_valid=valid_feedback,
+            dt_s=dt,
+        )
+
+        if not self.danger_latched:
+            self._relax_energy(float(dt_s))
+            self.gamma = 1.0
+            return 1.0
+
+        press_velocity = max(float(press_velocity_m_s), 0.0)
+        if valid_feedback:
+            requested_j = self._observe_fresh_feedback(
+                f_ext_z=float(f_ext_z),
+                actual_dx_m=float(actual_dx_m),
+                feedback_dt_s=feedback_dt,
+                command_dt_s=dt,
+                press_velocity_m_s=press_velocity,
+            )
+        else:
+            requested_j = 0.0
+
+        if press_velocity <= 0.0:
+            self.gamma = 1.0
+            return 1.0
+
+        # Once a danger episode is active, unknown actual motion is not a
+        # license to keep injecting press energy.  A short grace interval
+        # tolerates an isolated duplicate UDP frame; a held stream closes only
+        # the press direction while retract remains unchanged above.
+        if self.feedback_timed_out:
+            self.gamma = 0.0
+            return 0.0
+
+        # A duplicate frame carries no new energy observation.  Hold an
+        # already-active restriction instead of momentarily releasing it.
+        if not valid_feedback:
+            return float(self.gamma)
+        if requested_j <= 1.0e-12:
+            self.gamma = 1.0
+            return 1.0
+
+        available_j = max(
+            float(self.energy_j) - float(self.cfg.e_min_j), 0.0
+        )
+        gamma = max(0.0, min(1.0, available_j / requested_j))
+        # Never debit a command as if the mechanism achieved it.  Fresh
+        # measured displacement is the sole tank debit; the request sets only
+        # this tick's positive-press cap.
+        self.gamma = float(gamma)
+        return self.gamma
+
+    def step(
+        self,
+        *,
+        v_cmd_m_s: float,
+        f_ext_z: float,
+        f_des_z: float,
+        f_pred_z: float,
+        f_dot_z: float,
+        dx_tool_z_m: float = 0.0,
+        dx_fresh: bool = False,
+        dt_s: float = 0.0,
+        contact_present: bool = False,
+        press_power_w: float | None = None,
+    ) -> float:
+        """Velocity-valued wrapper retained for standalone use and replay."""
+
+        del press_power_w  # Residual power is derived from measured tracking.
+        v_raw = v_cmd_m_s
+        if not bool(self.cfg.enabled):
+            return v_raw
+        v_value = float(v_cmd_m_s)
+        gamma = self.update(
+            f_ext_z=f_ext_z,
+            desired_force_n=f_des_z,
+            force_pred_n=f_pred_z,
+            force_dot_n_s=f_dot_z,
+            force_task_latched=True,
+            physical_contact=contact_present,
+            compressing_actual=bool(dx_fresh and dx_tool_z_m > 0.0),
+            actual_dx_m=dx_tool_z_m,
+            feedback_fresh=dx_fresh,
+            dt_s=dt_s,
+            press_velocity_m_s=max(v_value, 0.0),
+            feedback_dt_s=dt_s,
+        )
+        if v_value <= 0.0 or gamma == 1.0:
+            return v_raw
+        return v_value * gamma
+
+    apply = step
+
+
+__all__ = ["HardContactEnergyGuard", "HardContactEnergyGuardConfig"]
