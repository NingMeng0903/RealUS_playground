+    def _init_hp_filter(self) -> None:
+        fs = 1.0 / self.dt if self.dt > 0 else 100.0
+        wn = min(
+            max(self.cfg.var_damping_omega_c_hz / (0.5 * fs), 1e-3),
+            0.99,
