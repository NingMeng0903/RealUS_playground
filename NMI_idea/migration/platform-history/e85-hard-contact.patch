+    def _consume_dx(self, dx_m: float) -> float:
+        self._dx_residual += float(dx_m)
+        dead = max(float(self.cfg.dx_deadband_m), 0.0)
+        if abs(self._dx_residual) < dead:
+            return 0.0
+        dx_used = self._dx_residual
+        self._dx_residual = 0.0
+        return dx_used
