+    def _run(self, path: str) -> None:
+        with open(path, "w", newline="") as f:
+            w = csv.writer(f)
+            w.writerow(self._HEADER)
+            n = 0
+            while True:
+                if self._stop.is_set() and self._q.empty():
+                    break
+                try:
+                    row = self._q.get(timeout=0.05)
+                except queue.Empty:
+                    continue
+                if row is None:
+                    break
+                w.writerow(row)
+                n += 1
+                if n % 200 == 0:
+                    f.flush()
