+        print(
+            f"  feedback: UDP push {async_obs.push_period_ms:.0f}ms "
+            f"port={async_obs.config.port} ip={async_obs._target_ip}",
+            flush=True,
+        )
+    ticks = 0
+    max_jitter_ms = 0.0
+    stutter_count = 0
+    stalled = False
+    total_t0 = time.perf_counter()
