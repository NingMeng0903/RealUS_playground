+        _guarded_move(
+            drive,
+            cfg,
+            v_post if target > 0 else -v_post,
+            what="post_home coarse",
+            timeout_s=15.0,
+            max_travel_m=abs(target) + 0.005,
+            stop_when=_near_coarse,
+            probe_s=0.35,
+            min_progress_m=0.0003,
+            log=_log,
+        )
+        _stop(drive)
+        time.sleep(0.15)
