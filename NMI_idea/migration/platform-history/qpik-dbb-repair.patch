+        # force rise.  Bound the approach kinetic energy by the remaining
+        # force headroom and, when supplied, the verified tank balance:
+        #
+        #   v_force = DeltaF / sqrt(M_eq K_e)
+        #   v_energy = sqrt(2 E_available / M_eq)
