+    def __init__(self, path: str) -> None:
+        self._q: queue.SimpleQueue = queue.SimpleQueue()
+        self._stop = threading.Event()
+        self._worker = threading.Thread(
+            target=self._run,
+            args=(path,),
+            name="joint-admittance-csv",
+            daemon=True,
+        )
+        self._worker.start()
