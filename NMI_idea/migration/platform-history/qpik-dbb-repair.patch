+        self.Dtrack = max(_finite(self.Dtrack), 1.0e-9)
+        self.M_p = max(_finite(self.M_p, 1.0), 1.0e-6)
+        self.D_p = max(_finite(self.D_p, 0.0), 0.0)
+        self.gamma_active = float(np.clip(_finite(self.gamma_active, 1.0), 0.0, 1.0))
