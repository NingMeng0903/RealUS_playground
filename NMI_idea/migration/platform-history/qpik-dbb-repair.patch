+                    elif settling:
+                        v_ff = 0.0
+                    prev_target = target
+
+                    err = target - measured
+                    de = (err - prev_err) / dt
+                    prev_err = err
+                    if abs(err) <= deadband_m and abs(v_ff) < 0.001 and abs(de) < 0.02:
+                        v_raw = 0.0
+                    else:
