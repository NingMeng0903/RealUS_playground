+    if damping is None:
+        if sigma_min is not None:
+            damping = sr_damping_lambda(sigma_min, sr_cfg)
+        else:
+            damping = 1e-4
+    m = J.shape[0]
+    lam2I = (damping * damping) * np.eye(m)
+    Jd = J.T @ np.linalg.solve(J @ J.T + lam2I, np.eye(m))
+    N = np.eye(J.shape[1]) - Jd @ J
+    return N @ qdot0
