+# Seat+inside may need ~0.90–1.03 axial scale (V8's ±3% is too tight).
+SCALE_MIN = 0.88
+SCALE_MAX = 1.05
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
