+    # Ranking: numeric_feasible first, then outside improvement magnitude.
+    ranked = sorted(
+        matrix["directions"],
+        key=lambda c: (
+            0 if c.get("numeric_feasible") else 1,
+            0 if c.get("contact_passed") else 1,
+            float(c.get("flex_femur_outside_cand_m", 1.0)),
