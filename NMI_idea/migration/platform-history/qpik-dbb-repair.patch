+                        panic=panic,
+                        poll_ok=poll_ok,
+                        dt_wall_ms=dt_wall * 1000.0,
+                        last_rpm_cmd=last_rpm,
+                        mb_fail_n=mb_fail_n,
+                        freeze_flag=moving_without_fb,
+                        arm_good=arm_good,
