+    try:
+        _pose0_rm = async_obs.wait_first_pose(timeout_s=5.0)
+        snap0 = async_obs.read()
+        if snap0.q_deg is None:
+            raise RuntimeError("no joint feedback from robot")
+        q0_rad = _expand_q_meas(
+            deg2rad(snap0.q_deg),
+            _rail_m_for_init(rail_bridge, inner),
+        )
