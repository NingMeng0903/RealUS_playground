+        # centering/arm cannot collapse the elbow while the plan feedforward
+        # (added next, unscaled) still drives the move branch.  Manipulability
+        # ascent is the inverse — keep it near singularities, fade at scan.
+        if not manipulability_active and sigma_min < sigma_ref:
+            fade = max(0.0, sigma_min / max(sigma_ref, 1e-6))
+            qdot0 = qdot0 * fade
