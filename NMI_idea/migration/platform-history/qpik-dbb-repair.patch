+@dataclass
+class QpDiagnostics:
+    """Per-level solver and residual telemetry."""
+
+    status: str = "not_run"
+    success: bool = False
+    iterations: int = 0
+    solve_time_s: float = 0.0
+    solve_time_ms: float = 0.0
+    active_constraint_ids: tuple[str, ...] = ()
+    residual_norm: float = float("nan")
+    max_constraint_violation: float = float("nan")
