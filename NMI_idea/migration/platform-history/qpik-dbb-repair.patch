+
+                    v_des = max(-v_max, min(v_max, v_raw))
+                    if settling:
+                        v_des = max(-settle_v, min(settle_v, v_des))
+                    # Soft ends: only when target is also near that end.
+                    if target <= approach_m and measured < approach_m and v_des < 0.0:
