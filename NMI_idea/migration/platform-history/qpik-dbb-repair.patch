+                prev_v_cmd = v_cmd
+                rpm = sign * self._mps_to_rpm(v_cmd)
+                self._drive.set_velocity_rpm(rpm)
+                if self._csv is not None:
+                    last_rpm = int(getattr(self._drive, "_last_rpm_cmd", 0) or 0)
+                    self._csv.write(
+                        event="",
+                        target_m=target,
+                        commanded_m=target,
+                        measured_m=measured,
+                        v_ff=v_ff,
+                        v_des=v_des,
+                        v_cmd=v_cmd,
+                        rpm=rpm,
+                        follow=follow,
