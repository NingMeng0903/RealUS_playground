+class PhaseCommandHub:
+    """Window A: owns ctl + payload SHM; hot-waits for START, runs WBC locally."""
+
+    def __init__(
+        self,
+        *,
+        ctl_name: str = DEFAULT_PHASE_CTL_NAME,
+        payload_name: str = DEFAULT_PHASE_PAYLOAD_NAME,
+    ) -> None:
