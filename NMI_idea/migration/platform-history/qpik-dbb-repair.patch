+def _mapped_q(rail: float, psi: float) -> np.ndarray:
+    q = np.zeros(8)
+    q[0] = rail
+    q[1] = psi
+    q[2] = 10.0 * rail
+    q[3] = -0.5 * psi
+    return q
+
