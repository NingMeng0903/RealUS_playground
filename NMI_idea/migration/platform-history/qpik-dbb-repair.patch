+                _send_joint_canfd_cmd(
+                    robot,
+                    rad2deg(arm_q_from_full(inner.q_cmd)),
+                    False,
+                    canfd_proxy,
+                )
+            except Exception:
+                if robot is not None:
+                    try:
+                        robot.rm_set_arm_slow_stop()
+                    except Exception:
+                        pass
