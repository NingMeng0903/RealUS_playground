+            if cmd_seq <= self._last_ack:
+                return None
+            cmd = PhaseCmd(int(self._ctl["cmd"]))
+            params = None
+            if cmd == PhaseCmd.START:
+                n = int(self._ctl["payload_len"])
+                if n <= 0 or n > PAYLOAD_MAX_BYTES:
+                    raise ValueError(f"invalid payload_len={n}")
