+    v_post = abs(float(cfg.home_to_post_m_s))
+    settle_m = 0.0003  # 0.3 mm accept (FA41 coast)
+    approach_band = 0.0015  # switch to creep 1.5 mm early
+    _log(f"[home] move to post_home={target * 1000:.1f} mm @ {v_post * 1000:.0f} mm/s")
