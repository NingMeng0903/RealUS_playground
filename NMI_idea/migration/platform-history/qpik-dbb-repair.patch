+    *,
+    q_start_deg: np.ndarray | None = None,
+    dt: float | None = None,
+    force_observer=None,
+    follow: bool = True,
+    move_speed: int = 20,
+    realtime: bool = False,
+    watchdog_timeout_s: float = 0.1,
