+        # Always re-capture: yaml may seed q_ref_m=0.0 as a placeholder, and HOLD
+        # without an explicit ref means "hold where we are now".
+        self.q_ref = float(np.asarray(q_rad, dtype=float)[RAIL_INDEX])
+
