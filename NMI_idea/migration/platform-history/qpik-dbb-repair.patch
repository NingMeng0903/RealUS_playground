+            rail_escape_travel_m=0.0,
+            rail_escape_v_des_m_s=rail_escape_v_des,
+            twist_scale=float(twist_scale),
+            cart_translation_weight_effective=cart_translation_weight_effective,
+            rail_vel_pin=(
