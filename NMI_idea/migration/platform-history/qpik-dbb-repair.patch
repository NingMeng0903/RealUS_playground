+@dataclass(frozen=True)
+class BedSurfaceCalib:
+    name: str
+    center: tuple[float, float, float]
+    size: tuple[float, float, float]
+    rotation_deg: float
+    color: tuple[float, float, float, float] = (0.55, 0.78, 0.95, 1.0)
