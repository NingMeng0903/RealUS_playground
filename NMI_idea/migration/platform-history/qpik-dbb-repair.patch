+
+        lo_box, hi_box = self.constraints.bounds(
+            q_prev,
+            dt,
+            self.qdot_prev,
+            q_meas=q_meas,
+            resync_err=resync_err,
+            rail_locked=rail_locked,
+            rail_lock_vel_eps_m_s=rail_lock_vel_eps_m_s,
+            rail_vel_pin_m_s=rail_vel_pin_m_s,
+        )
