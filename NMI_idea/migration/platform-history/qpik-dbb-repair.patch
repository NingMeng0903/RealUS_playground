+"""Cartesian pose CANFD (rm_movep_canfd) with optional Ruckig preprocessing."""
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass, field
+from typing import Any, Iterator, Sequence
+
+import numpy as np
