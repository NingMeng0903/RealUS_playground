+        dt=dt,
+        force_observer=force_observer,
+        follow=follow,
+        move_speed=move_speed,
+        realtime=realtime,
+        watchdog_timeout_s=watchdog_timeout_s,
+        on_step=on_step_1,
+        log_csv=log_csv,
+        verbose=verbose,
+        state_bus=state_bus,
+        rail_bridge=rail_bridge,
+    )
