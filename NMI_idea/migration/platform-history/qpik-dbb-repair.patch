+                if self._m_diag_lpf is None:
+                    self._m_diag_lpf = m_diag.copy()
+                else:
+                    alpha = min(1.0, dt / tau)
+                    self._m_diag_lpf += alpha * (m_diag - self._m_diag_lpf)
