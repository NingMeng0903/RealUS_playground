+            d_eff = d_eff * (1.0 + self.adaptive_d_null_gain * u_max)
+        if d_eff > 0.0 and qdot_prev is not None:
+            qdot0 = qdot0 - d_eff * np.asarray(qdot_prev, dtype=float)
