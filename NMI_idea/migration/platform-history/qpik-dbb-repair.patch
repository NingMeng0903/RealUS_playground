+    if psi_live_left and inner.arm_task is not None:
+        psi_live = float(inner.arm_task.arm_angle(q_live_rad))
+        return resolve_psi_sides_live(
+            psi_center,
+            psi_live,
+            fallback_offset_rad=side_offset_rad,
