+def _point_triangle_distances(points: np.ndarray, triangles: np.ndarray) -> np.ndarray:
+    """Euclidean distances for paired points/triangles, including degenerate faces."""
+    a, b, c = np.moveaxis(np.asarray(triangles, dtype=np.float64), 1, 0)
+    p = np.asarray(points, dtype=np.float64)
+    ab, ac, ap = b - a, c - a, p - a
+    normal = np.cross(ab, ac)
+    n2 = np.einsum("ij,ij->i", normal, normal)
+    signed = np.einsum("ij,ij->i", ap, normal)
+    projected = p - (signed / np.maximum(n2, 1.0e-30))[:, None] * normal
+    v = projected - a
+    aa = np.einsum("ij,ij->i", ab, ab)
+    bb = np.einsum("ij,ij->i", ac, ac)
+    cc = np.einsum("ij,ij->i", ab, ac)
+    av = np.einsum("ij,ij->i", ab, v)
+    cv = np.einsum("ij,ij->i", ac, v)
+    denom = aa * bb - cc * cc
+    u = (bb * av - cc * cv) / np.maximum(denom, 1.0e-30)
+    w = (aa * cv - cc * av) / np.maximum(denom, 1.0e-30)
+    inside = (n2 > 1.0e-30) & (u >= -1.0e-12) & (w >= -1.0e-12) & (u + w <= 1.0 + 1.0e-12)
+    dist2 = np.full(len(p), np.inf)
+    for first, last in ((a, b), (b, c), (c, a)):
+        edge = last - first
+        t = np.clip(np.einsum("ij,ij->i", p - first, edge) / np.maximum(np.einsum("ij,ij->i", edge, edge), 1.0e-30), 0.0, 1.0)
+        delta = p - first - t[:, None] * edge
+        dist2 = np.minimum(dist2, np.einsum("ij,ij->i", delta, delta))
+    dist2[inside] = signed[inside] ** 2 / n2[inside]
+    return np.sqrt(np.maximum(dist2, 0.0))
+
