+class _TriangleSurfaceDistance:
+    def __init__(self, vertices: np.ndarray, faces: np.ndarray) -> None:
+        from scipy.spatial import cKDTree
+
+        # Keep source arrays alive: their addresses form the cache identity.
+        self.vertices, self.faces = vertices, faces
+        self.triangles = np.asarray(vertices, dtype=np.float64)[np.asarray(faces, dtype=np.int64)]
+        self.centers = self.triangles.mean(axis=1)
+        self.max_radius = float(np.linalg.norm(self.triangles - self.centers[:, None], axis=2).max())
+        self.tree = cKDTree(self.centers)
+        self.vertex_tree = cKDTree(np.asarray(vertices, dtype=np.float64))
+
+    def query(self, points: np.ndarray) -> np.ndarray:
+        points = np.asarray(points, dtype=np.float64).reshape(-1, 3)
+        result = np.empty(len(points), dtype=np.float64)
+        for start in range(0, len(points), 256):
+            batch = points[start:start + 256]
+            _, closest = self.tree.query(batch)
+            upper = _point_triangle_distances(batch, self.triangles[closest])
+            # Any closer triangle has its centroid within upper + its radius.
+            # This radius search makes the result exact, unlike fixed k-nearest faces.
+            candidates = self.tree.query_ball_point(batch, upper + self.max_radius + 1.0e-12)
+            counts = np.asarray([len(row) for row in candidates], dtype=np.int64)
+            ids = np.concatenate(candidates).astype(np.int64)
+            distances = _point_triangle_distances(np.repeat(batch, counts, axis=0), self.triangles[ids])
