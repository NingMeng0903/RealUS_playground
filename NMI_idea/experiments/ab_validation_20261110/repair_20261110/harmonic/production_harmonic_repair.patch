+"""Rebuild a validated shaft ROI from true skin-plane intersections.
+
+This is a restricted chart, not a replacement for the whole-leg PLC domain.
+Geometry validity, scalar harmonicity, and coordinate injectivity are separate
+checks. Fixed SMPL-X attachments are returned for pose validation.
+"""
+from __future__ import annotations
+from dataclasses import replace
+import numpy as np
+from .atlas import LegVolumeAtlas, _compute_vertex_normals
+
+
+def parallel_transport_frames(tangents: np.ndarray, reference: np.ndarray) -> np.ndarray:
+    t = np.asarray(tangents, float)
+    t = t / np.linalg.norm(t, axis=1)[:, None]
+    a = np.asarray(reference, float) - t[0] * (reference @ t[0])
+    a /= np.linalg.norm(a)
+    result = []
+    for i, direction in enumerate(t):
+        if i:
+            cross = np.cross(t[i - 1], direction)
+            sine, cosine = np.linalg.norm(cross), t[i - 1] @ direction
+            if sine > 1.e-14:
+                axis = cross / sine
+                a = a * cosine + np.cross(axis, a) * sine + axis * (axis @ a) * (1 - cosine)
+            a -= direction * (a @ direction)
+            a /= np.linalg.norm(a)
+        result.append(np.stack([a, np.cross(direction, a), direction], axis=1))
+    return np.asarray(result)
+
+
+def ray_segment_hits(lines: np.ndarray, angle: float) -> tuple[np.ndarray, np.ndarray]:
+    direction = np.array([np.cos(angle), np.sin(angle)])
+    a, edge = lines[:, 0], lines[:, 1] - lines[:, 0]
+    cross = lambda x, y: x[..., 0] * y[..., 1] - x[..., 1] * y[..., 0]
+    denominator = cross(direction, edge)
+    good = abs(denominator) > 1.e-14
+    radius, u = np.full(len(a), np.inf), np.full(len(a), np.inf)
+    radius[good] = cross(a[good], edge[good]) / denominator[good]
+    u[good] = cross(a[good], direction) / denominator[good]
+    candidates = np.flatnonzero(good & (radius > 1.e-8) & (u >= -1.e-8) & (u <= 1 + 1.e-8))
+    candidates = candidates[np.argsort(radius[candidates])]
+    unique = []
+    for index in candidates:
+        if not unique or abs(radius[index] - radius[unique[-1]]) > 1.e-7:
+            unique.append(index)
+    return np.asarray(unique, int), radius
+
+
+def tet_determinants(vertices: np.ndarray, tets: np.ndarray) -> np.ndarray:
+    corners = np.asarray(vertices, float)[tets]
+    return np.linalg.det(np.moveaxis(corners[:, 1:] - corners[:, :1], 1, 2))
+
+
+def native_boundary_surface(tets: np.ndarray, boundary_vertices: np.ndarray, vertex_count: int) -> np.ndarray:
+    """Extract oriented faces from the actual positive-oriented native tets."""
+    on_surface = np.zeros(vertex_count, bool)
+    on_surface[boundary_vertices] = True
+    near = tets[np.sum(on_surface[tets], axis=1) >= 3]
+    # Outward face orientations for a positive tetrahedron.
+    faces = np.concatenate([near[:, indices] for indices in ([1, 2, 3], [0, 3, 2], [0, 1, 3], [0, 2, 1])])
+    faces = faces[np.all(on_surface[faces], axis=1)]
+    _, first, count = np.unique(np.sort(faces, axis=1), axis=0, return_index=True, return_counts=True)
+    faces = faces[first[count == 1]]
+    local = np.full(vertex_count, -1, np.int32)
+    local[boundary_vertices] = np.arange(len(boundary_vertices))
+    return local[faces].astype(np.int32)
+
+
+def graph_laplacian(vertices: np.ndarray, tets: np.ndarray):
+    from scipy import sparse
+    edges = np.concatenate([tets[:, pair] for pair in ([0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3])])
+    edges = np.unique(np.sort(edges, axis=1), axis=0)
+    delta = np.asarray(vertices, float)[edges[:, 0]] - np.asarray(vertices, float)[edges[:, 1]]
+    weight = 1. / np.maximum(np.einsum('ij,ij->i', delta, delta), 1.e-20)
+    a, b = edges.T
+    degree = np.bincount(a, weights=weight, minlength=len(vertices)) + np.bincount(b, weights=weight, minlength=len(vertices))
+    return sparse.coo_matrix((np.r_[-weight, -weight, degree],
+        (np.r_[a, b, np.arange(len(vertices))], np.r_[b, a, np.arange(len(vertices))])),
+        shape=(len(vertices), len(vertices))).tocsr()
+
+
+def build_shaft_roi(atlas: LegVolumeAtlas, surface_weights: np.ndarray, *, h_min: float = .14,
+    h_max: float = .94, station_count: int = 48, theta_count: int = 72, radial_count: int = 8,
+    inner_frac: float = .04, smoothing: float = 1.e-4) -> tuple[LegVolumeAtlas, dict[str, np.ndarray], dict[str, object]]:
+    import trimesh
+    from scipy.interpolate import splprep, splev
+    from scipy.sparse.linalg import spsolve
+
+    if not (0 < inner_frac < 1 and h_min < h_max and radial_count >= 3):
+        raise ValueError('Invalid shaft ROI bounds/resolution')
+    w = np.asarray(surface_weights, float)
+    if len(w) != len(atlas.skin_vertices) or np.min(w) < -1.e-12 or not np.isfinite(w).all():
+        raise ValueError('Surface attachments must be finite, nonnegative, and match source skin')
+    w = w / w.sum(axis=1)[:, None]
+    mesh = trimesh.Trimesh(atlas.skin_vertices, atlas.skin_faces, process=False)
+    stations = np.linspace(h_min, h_max, station_count)
+    angles = np.linspace(0, 2 * np.pi, theta_count, endpoint=False)
+    fractions = np.linspace(inner_frac, 1., radial_count)
+    spline, _ = splprep(np.asarray(atlas.core_points, float).T, u=atlas.core_h, s=smoothing, k=3)
+    centers = np.asarray(splev(stations, spline)).T
+    tangent = np.asarray(splev(stations, spline, der=1)).T
+    frames = parallel_transport_frames(tangent, np.asarray(atlas.pelvis - atlas.hip, float))
+    outer = np.zeros((station_count, theta_count, 3))
+    outer_w = np.zeros((station_count, theta_count, w.shape[1]))
+    face_ids = np.empty((station_count, theta_count), int)
+    barycentric = np.empty((station_count, theta_count, 3))
+    hit_counts = np.zeros((station_count, theta_count), int)
+    radii = np.zeros_like(hit_counts, float)
+    for si, (center, frame) in enumerate(zip(centers, frames)):
+        lines, source_faces = trimesh.intersections.mesh_plane(mesh, frame[:, 2], center, return_faces=True)
+        uv = (lines - center) @ frame[:, :2]
+        _, degrees = np.unique(np.round(uv.reshape(-1, 2) / 1.e-7).astype(np.int64), axis=0, return_counts=True)
+        if not len(lines) or np.any(degrees != 2):
+            raise ValueError(f'Open/nonmanifold geometric skin section at h={stations[si]:.8f}')
+        for ti, angle in enumerate(angles):
+            hits, distance = ray_segment_hits(uv, float(angle))
+            hit_counts[si, ti] = len(hits)
+            if len(hits) != 1:
+                raise ValueError(f'Non-star-shaped section h={stations[si]:.8f}, theta={angle:.8f}: {len(hits)} hits')
+            hit = hits[0]
+            point = center + distance[hit] * (np.cos(angle) * frame[:, 0] + np.sin(angle) * frame[:, 1])
+            face = int(source_faces[hit])
+            bary = trimesh.triangles.points_to_barycentric(np.asarray(atlas.skin_vertices[atlas.skin_faces[[face]]], float), point[None])[0]
+            if np.min(bary) < -1.e-6:
+                raise ValueError('Skin intersection escaped its source triangle')
+            bary = np.maximum(bary, 0); bary /= bary.sum()
+            outer[si, ti], face_ids[si, ti], barycentric[si, ti] = point, face, bary
+            outer_w[si, ti] = bary @ w[atlas.skin_faces[face]]
+            radii[si, ti] = distance[hit]
+    vertices = (centers[:, None, None, :] + fractions[None, :, None, None] * (outer[:, None] - centers[:, None, None, :])).reshape(-1, 3)
+    core_w = outer_w.mean(axis=1)
+    volume_w = (fractions[None, :, None, None] * outer_w[:, None] + (1 - fractions[None, :, None, None]) * core_w[:, None, None]).reshape(-1, w.shape[1])
+    grid = np.arange(len(vertices)).reshape(station_count, radial_count, theta_count)
+    a = grid[:-1, :-1]; b = np.roll(a, -1, axis=2); c = grid[:-1, 1:]; d = np.roll(c, -1, axis=2)
+    e = grid[1:, :-1]; f = np.roll(e, -1, axis=2); g = grid[1:, 1:]; k = np.roll(g, -1, axis=2)
+    tets = np.stack([np.stack(z, axis=-1) for z in ((a,b,d,k),(a,d,c,k),(a,c,g,k),(a,g,e,k),(a,e,f,k),(a,f,b,k))], axis=-2).reshape(-1, 4).astype(np.int32)
+    # One global orientation convention for (h,r,theta); never flip bad cells.
+    tets[:, [0, 1]] = tets[:, [1, 0]]
+    vertices = vertices.astype(np.float32)
+    determinant = tet_determinants(vertices, tets)
+    if np.any(determinant <= 0):
+        raise ValueError(f'ROI geometry rejected: {int(sum(determinant <= 0))} nonpositive tetrahedra after float32 serialization')
+    inner, skin_ids = grid[:, 0].ravel(), grid[:, -1].ravel()
+    lap = graph_laplacian(vertices, tets)
+    fixed = np.r_[inner, skin_ids]
+    fixed_values = np.r_[np.ones(len(inner)), np.zeros(len(skin_ids))]
+    free = np.setdiff1d(np.arange(len(vertices)), fixed)
+    depth = np.zeros(len(vertices)); depth[fixed] = fixed_values
+    depth[free] = spsolve(lap[free][:, free], -(lap[free][:, fixed] @ fixed_values))
+    if np.min(depth) < -1.e-7 or np.max(depth) > 1 + 1.e-7:
+        raise ValueError('Discrete harmonic depth violates its maximum principle')
+    depth = np.clip(depth, 0, 1).astype(np.float32)
+    hh = np.broadcast_to(stations[:, None, None], grid.shape).ravel().astype(np.float32)
+    theta = np.broadcast_to(angles[None, None], grid.shape).ravel().astype(np.float32)
+    xi = np.column_stack([theta, hh, depth])
+    material = xi[tets].astype(float)
+    material[:, :, 0] = material[:, :1, 0] + (material[:, :, 0] - material[:, :1, 0] + np.pi) % (2 * np.pi) - np.pi
+    material_j = np.linalg.det(np.moveaxis(material[:, 1:] - material[:, :1], 1, 2)) / determinant
+    if np.any(material_j >= -1.e-8):
+        raise ValueError(f'ROI address map rejected: {int(sum(material_j >= -1.e-8))} material folds/degeneracies')
+    # Surface connectivity from the same native outer shell as the volume.
+    faces = native_boundary_surface(tets, skin_ids, len(vertices))
+    skin = vertices[skin_ids]
+    native_ids = atlas.full_vertex_indices[atlas.skin_faces[face_ids.ravel()][np.arange(len(skin_ids)), np.argmax(barycentric.reshape(-1,3),axis=1)]]
+    # Source fields describe a different bake; retain them only as provenance,
+    # never as solver/layout declarations for this rebuilt chart.
+    meta = {'source_surface_metadata': dict(atlas.metadata)}
+    ownership = dict(atlas.metadata.get('side_face_ownership', {}))
+    ownership.pop('candidate_only', None)
+    ownership.pop('volume_arrays_are_old_and_invalid', None)
+    meta.update(method='shaft_roi_radial_transport_graph_harmonic_depth',
+        mesh_type='geometric_section_shaft_roi', coordinate_domain='shaft_roi', default_depth_mode='baked',
+        domain_h_range=[h_min,h_max], station_count=station_count,theta_count=theta_count,radial_count=radial_count,
+        inner_fraction=inner_frac, centerline_method='cubic_smoothing_spline',frame_method='parallel_transport',
+        surface_method='true_triangle_plane_intersection_single_ray_hit',depth_method='positive_edge_weight_graph_laplace_dirichlet',
+        h_method='transported_centerline_station',theta_method='parallel_transport_periodic_angle',
+        volume_vertex_count=len(vertices),volume_tet_count=len(tets),volume_sample_count=len(vertices),
+        skin_vertex_count=len(skin),skin_face_count=len(faces),
+        depth_one_boundary='inner_shell_at_radial_fraction; centerline_is_outside_annular_domain',
+        material_coordinate_orientation=-1,full_vertex_indices_semantics='dominant_source_triangle_vertex_diagnostic_only',
+        scope='restricted_shaft_roi_not_whole_leg',side_face_ownership=ownership)
+    rebuilt = replace(atlas,skin_vertices=skin,skin_faces=faces,skin_h=hh[skin_ids],skin_theta=theta[skin_ids],skin_d=depth[skin_ids],
+        skin_normals=_compute_vertex_normals(skin,faces),full_vertex_indices=native_ids,core_h=stations.astype(np.float32),core_points=centers.astype(np.float32),
+        harmonic_vertices=vertices,harmonic_tets=tets,harmonic_h=hh,harmonic_theta=theta,harmonic_d=depth,
+        volume_points=vertices,volume_xi=xi,metadata=meta)
+    residual = lap[free] @ depth.astype(float)
+    curvature = np.linalg.norm(np.cross(tangent, np.asarray(splev(stations,spline,der=2)).T),axis=1) / np.linalg.norm(tangent,axis=1)**3
+    metrics = dict(vertices=len(vertices),tets=len(tets),det_min=float(determinant.min()),det_max=float(determinant.max()),
+        material_J_min=float(material_j.min()),material_J_max=float(material_j.max()),nonpositive_tets=0,material_fold_tets=0,
+        max_curvature_times_radius=float(np.max(curvature * radii.max(axis=1))),ray_hit_count_min=int(hit_counts.min()),ray_hit_count_max=int(hit_counts.max()),
+        harmonic_relative_residual=float(np.linalg.norm(residual)/max(np.linalg.norm(lap[free][:,fixed]@fixed_values),1.e-30)))
+    attachment = dict(volume_lbs_weights=volume_w.astype(np.float32),surface_lbs_weights=outer_w.reshape(-1,w.shape[1]).astype(np.float32),
+        core_lbs_weights=core_w.astype(np.float32),source_surface_face_indices=face_ids.ravel(),source_surface_barycentric=barycentric.reshape(-1,3),
+        radial_fractions=fractions,grid_shape=np.array(grid.shape),frames=frames,ray_hit_counts=hit_counts,material_jacobians=material_j)
+    return rebuilt, attachment, metrics
