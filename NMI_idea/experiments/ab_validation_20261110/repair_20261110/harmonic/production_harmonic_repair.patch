+"""Explicit shaft ROI query/transport entry, independent of cached vessel projections."""
+from __future__ import annotations
+from dataclasses import replace
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import sys
+import numpy as np
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(REPO), str(REPO / 'src')]
+from DMP_playground.configs.load_config import load_playground_config
+from DMP_playground.core_algorithms.patch_binding import load_canonical_bundle
+from projects.genesis_ue_sync.anatomy_retarget.anatomy_lbs import joint_global_transforms
+from projects.genesis_ue_sync.anatomy_retarget.leg_volume_coordinates.atlas import load_leg_volume_atlas, query_atlas_coordinates
+from projects.genesis_ue_sync.anatomy_retarget.leg_volume_coordinates.volume_refine import VolumeTetRefiner
+from projects.genesis_ue_sync.anatomy_retarget.leg_volume_coordinates.harmonic import locate_baked_tetrahedra
+from projects.genesis_ue_sync.anatomy_retarget.leg_volume_coordinates.lbs_bridge import blend_lbs_transforms
+
+
+def query_and_transport(config_path: Path | str, *, xi: np.ndarray | None = None,
+                        point: np.ndarray | None = None, knee_deg: float = 60.) -> dict[str, object]:
+    config = load_playground_config(config_path)['volume_coordinates']
+    atlas_path, weights_path = Path(config['atlas_path']), Path(config['attachments_path'])
+    atlas = load_leg_volume_atlas(atlas_path)
+    manifest = json.loads(Path(config['asset_hashes_path']).read_text())
+    for path, role in ((atlas_path, f'atlas_{atlas.side}.npz'), (weights_path, f'attachments_{atlas.side}.npz')):
+        if hashlib.sha256(path.read_bytes()).hexdigest() != manifest[role]:
+            raise ValueError(f'Coordinate bundle hash/side mismatch: {path}')
+    attachment = np.load(weights_path, allow_pickle=False)
+    weights = attachment['volume_lbs_weights']
+    if len(weights) != len(atlas.harmonic_vertices) or np.min(weights) < 0 or np.max(abs(weights.sum(1) - 1)) > 1.e-5:
+        raise ValueError('Invalid fixed volume attachment weights')
+    refiner = VolumeTetRefiner.from_atlas(atlas)
+    if xi is not None:
+        canonical_point = refiner.xi_to_p(np.asarray(xi).reshape(1, 3))
+    elif point is not None:
+        canonical_point = np.asarray(point, np.float64).reshape(1, 3)
+    else:
+        raise ValueError('Provide exactly one canonical point or material address')
+    canonical_xi = query_atlas_coordinates(atlas, canonical_point)[0]
+    inverse = refiner.xi_to_p(canonical_xi)
+    cells, bary = locate_baked_tetrahedra(refiner.fields, canonical_point)
+    canonical = load_canonical_bundle(config['canonical_dir'])
+    joint_names = [str(x) for x in canonical['joint_names']]
+    pose = np.zeros((len(joint_names), 3), np.float32)
+    pose[joint_names.index(f'{atlas.side}_knee'), 0] = np.deg2rad(knee_deg)
+    global_transforms = joint_global_transforms(pose_axis_angle=pose.ravel(), rest_joints=canonical['rest_joints'], parents=canonical['parents'])
+    transforms = global_transforms @ canonical['inverse_bind']
+    blended = blend_lbs_transforms(weights, transforms)
+    vertices = np.einsum('nij,nj->ni', blended, np.column_stack([atlas.harmonic_vertices, np.ones(len(weights), np.float32)]))[:, :3].astype(np.float32)
+    posed_point = np.einsum('ni,nij->nj', bary, vertices[atlas.harmonic_tets[cells]])
+    grid = np.arange(len(vertices)).reshape(tuple(attachment['grid_shape']))
+    posed_atlas = replace(atlas, harmonic_vertices=vertices, skin_vertices=vertices[grid[:, -1].ravel()])
+    posed_xi = query_atlas_coordinates(posed_atlas, posed_point)[0]
+    difference = posed_xi - canonical_xi
+    difference[:, 0] = (difference[:, 0] + np.pi) % (2 * np.pi) - np.pi
+    return dict(scope='shaft ROI point query and piecewise-linear tetra transport; no vessel or servo claim',
+        atlas_path=str(atlas_path), attachments_path=str(weights_path), domain_h_range=atlas.metadata['domain_h_range'],
+        side=atlas.side, knee_deg=knee_deg, canonical_point_m=canonical_point[0].tolist(), material_xi=canonical_xi[0].tolist(),
+        inverse_error_m=float(np.linalg.norm(inverse-canonical_point)), native_tet_index=int(cells[0]), barycentric=bary[0].tolist(),
+        posed_point_m=posed_point[0].tolist(), posed_material_xi=posed_xi[0].tolist(), material_transport_abs_error=abs(difference[0]).tolist())
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', type=Path, required=True)
+    choice = parser.add_mutually_exclusive_group(required=True)
+    choice.add_argument('--xi', nargs=3, type=float, metavar=('THETA', 'H', 'D'))
+    choice.add_argument('--point', nargs=3, type=float, metavar=('X', 'Y', 'Z'))
+    parser.add_argument('--knee-deg', type=float, default=60.)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    result = query_and_transport(args.config, xi=args.xi, point=args.point, knee_deg=args.knee_deg)
+    payload = json.dumps(result, indent=2)
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(payload)
+    print(payload)
+
+
+if __name__ == '__main__':
+    main()
