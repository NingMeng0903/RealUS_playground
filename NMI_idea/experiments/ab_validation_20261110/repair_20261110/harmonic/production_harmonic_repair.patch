+    if not len(faces):
+        raise ValueError("Leg ROI contains no skin faces")
+    edges = np.concatenate([faces[:, [0, 1]], faces[:, [1, 2]], faces[:, [2, 0]]])
+    graph = coo_matrix((np.ones(len(edges)), (edges[:, 0], edges[:, 1])), shape=(len(full_idx), len(full_idx))).tocsr()
+    count, labels = connected_components(graph, directed=False)
