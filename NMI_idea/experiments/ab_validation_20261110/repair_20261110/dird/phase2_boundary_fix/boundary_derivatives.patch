+def command_derivatives(velocities, dt_s, velocity_before=None, acceleration_before=None):
+    """Command acceleration/jerk with the actual preceding command history.
+
+    At a path/hold boundary the preceding velocity and acceleration are not
+    reset. Defaults describe only a stationary root. Rejected final proposals
+    remain visible in diagnostic maxima; they do not become exit history.
+    """
+    velocities = np.asarray(velocities, dtype=float)
+    if velocities.ndim != 2 or velocities.shape[1] != 8:
+        raise ValueError('command velocities must have shape (N,8)')
+    if not np.isfinite(dt_s) or dt_s <= 0:
+        raise ValueError('dt_s must be finite and positive')
+    v0 = np.zeros(8) if velocity_before is None else np.asarray(velocity_before, dtype=float)
+    a0 = np.zeros(8) if acceleration_before is None else np.asarray(acceleration_before, dtype=float)
+    if v0.shape != (8,) or a0.shape != (8,):
+        raise ValueError('preceding command velocity and acceleration must have shape (8,)')
+    acceleration = np.diff(np.vstack((v0, velocities)), axis=0) / dt_s
+    jerk = np.diff(np.vstack((a0, acceleration)), axis=0) / dt_s
+    return acceleration, jerk
+
