"""Supervise existing PEIRASTIC modes; never connect directly to robot sockets."""
from __future__ import annotations

from collections import deque
import fcntl
import hashlib
import os
import queue
import threading
import time

import numpy as np
from scipy.spatial.transform import Rotation

import record
from scan_contact import ENTRY_N, ENTRY_S, RELEASE_N, ReleaseDetector
from peirastic.api import PeirasticArm
from peirastic.core.ipc import Status
from peirastic.core.modes import Mode, ModeRequest
from peirastic.core.session import pad_may_drive
from peirastic.scan_path import ForearmReference, SCAN_FORCE_AXES, force_profile, lift_pose, outward
from realus_clock import get_clock


class LiveSamples:
    """Reuse recorder SHM pairing without receiving/decoding another image stream."""
    def __init__(self, args):
        options = record.parse_args(["--repo", str(args.repo), "--state-shm", args.state_shm,
                                     "--shm-prefix", args.shm_prefix, "--max-source-age", "0.1"])
        if args.force_shm:
            options.force_shm = args.force_shm
        self.queue = queue.Queue(maxsize=1024)
        self.collector = record.Collector(options, record.Clock(), self.queue, threading.Event())
        self.latest = {}
        self.history = deque(maxlen=100)

    def poll(self):
        self.collector.poll_shm()
        while True:
            try:
                group, row = self.queue.get_nowait()
            except queue.Empty:
                break
            self.latest[group] = row
            if group == "tcp":
                self.history.append(row)
        return self.latest

    def fresh(self, group):
        self.poll()
        row = self.latest.get(group)
        if row is None or not 0 <= time.monotonic_ns() - row["timestamp_mono_ns"] <= 100_000_000:
            raise RuntimeError(f"Stale or missing {group} feedback.")
        return row

    def taught(self):
        latest = self.fresh("tcp")
        if not all(np.isfinite(latest[k]).all() for k in
                   ("pose_m_rad", "q_deg", "rail_m", "wrench_raw_sensor")):
            raise RuntimeError("Invalid teaching feedback.")
        recent = [r for r in self.history if latest["timestamp_mono_ns"] - r["timestamp_mono_ns"] <= 300_000_000]
        if len(recent) < 5 or latest["timestamp_mono_ns"] - recent[0]["timestamp_mono_ns"] < 200_000_000:
            raise RuntimeError("Hold still for 0.3 s, then press Enter.")
        poses = np.array([r["pose_m_rad"] for r in recent])
        q = np.array([r["q_deg"] for r in recent])
        rail = np.array([r["rail_m"] for r in recent])
        rot = Rotation.from_euler("xyz", poses[:, 3:])
        angle = (rot[-1].inv() * rot).magnitude()
        if (np.max(np.linalg.norm(poses[:, :3]-poses[-1, :3], axis=1)) > 0.0005
                or np.max(angle) > np.deg2rad(0.3) or np.max(np.ptp(q, axis=0)) > 0.15
                or np.ptp(rail) > 0.0005):
            raise RuntimeError("Still moving. Release sticks and retry.")
        return dict(latest, clock_id=get_clock().clock_id,
                    header=get_clock().header("world", timestamp_ns=latest["timestamp_ns"]))

    def close(self):
        for name in ("state", "force", "controller"):
            getattr(self.collector, name).close()
        for reader in self.collector.headers.values():
            reader.close()


class Robot:
    def __init__(self, args):
        self.args = args
        key = hashlib.sha256(args.shm_prefix.encode()).hexdigest()[:16]
        self.lock_fd = os.open(f"/dev/shm/realus_icra_supervisor_{os.getuid()}_{key}.lock",
                               os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BaseException:
            os.close(self.lock_fd)
            raise RuntimeError("Another scan session is active.")
        # Attach only to IPC. The scanner does not open robot SDK/TCP/UDP channels.
        try:
            self.arm = PeirasticArm(prefix=args.shm_prefix)
            if getattr(args, "contact_qp", None) is not None:
                self.preflight_contact_qp(args.contact_qp)
            self.samples = LiveSamples(args)
        except BaseException:
            os.close(self.lock_fd)
            if hasattr(self, "arm"):
                self.arm.close()
            raise
        self.expected_seq = None
        self.automatic = False
        self.air_verified = False
        self.stages = {}
        self._recording = None
        self._standoff_target = None
        self._air_motion = False
        self._calibration_apex = None

    def mark(self, name):
        self.stages[name] = get_clock().now_ns()

    def status(self, *, allow_latched=False):
        self.samples.poll()
        snap = self.arm._snapshot()
        if not snap or not 0 <= time.monotonic() - float(snap["t_mono"]) < 0.5:
            raise RuntimeError("Controller feedback stale.")
        if not allow_latched and (snap["estop"] or snap["status"] in
                                  (int(Status.STOPPED), int(Status.ESTOP), int(Status.ERROR))):
            raise RuntimeError(f"Controller stopped: {snap.get('msg')}. Recover manually.")
        if self.expected_seq is not None and int(snap["cmd_seq"]) != self.expected_seq:
            raise RuntimeError("Control taken by another command.")
        if self._recording is not None:
            self._recording.poll()
        if self._air_motion or self._standoff_target is not None:
            if pad_may_drive(snap["mode"], label=str(snap.get("msg", ""))):
                raise RuntimeError("Unsafe pad handoff during air positioning. Restart updated controller.")
        if self._air_motion and abs(self._fz()) >= ENTRY_N:
            raise RuntimeError("Unexpected contact during air positioning.")
        if self._standoff_target is not None:
            # Recorder startup is still automatic positioning, not pad time.
            live = self._pose()
            target = self._standoff_target
            angle = (Rotation.from_euler("xyz", live[3:]).inv() *
                     Rotation.from_euler("xyz", target[3:])).magnitude()
            if np.linalg.norm(live[:3] - target[:3]) > 0.004 or angle > np.deg2rad(3):
                raise RuntimeError("Standoff drift before contact seek.")
            if abs(self._fz()) >= ENTRY_N:
                raise RuntimeError("Unexpected contact at standoff.")
        return snap

    def idle_tick(self):
        # Continue observing stop/feedback state while the operator reads a prompt.
        self.samples.poll()

    def check(self):
        return self.status()

    def _accepted(self, ret):
        if ret != 0:
            raise RuntimeError(f"Command rejected: {ret}.")
        self.expected_seq = int(self.arm.last_seq)

    def begin_teaching(self):
        self.expected_seq = None
        snap = self.status()
        if (snap["status"] == int(Status.RUNNING)
                and not pad_may_drive(snap["mode"], label=snap["msg"])
                and not str(snap["msg"]).startswith("icra_")):
            raise RuntimeError("Another automatic task is active.")
        self.air_verified = False
        self.automatic = False
        # Preserve a live pad hybrid; otherwise return a position-hold pad mode.
        if not (snap["mode"] == int(Mode.TRACK_HYBRID) and "pad" in snap["msg"]):
            seq = self.arm.client.set_mode(ModeRequest(Mode.SERVO_TWIST_HOLD,
                                {"label": "servo_twist_hold", "filter": False}))
            if self.arm.client.wait_installed(seq, Mode.SERVO_TWIST_HOLD) != 0:
                raise RuntimeError("Failed to return pad control.")

    def capture(self, hand, point):
        snap = self.status()
        if snap["mode"] != int(Mode.TRACK_HYBRID) or "pad" not in snap["msg"]:
            raise RuntimeError("Press L3 for pad hybrid mode first.")
        if not np.isfinite(snap["pad_hz"]) or snap["pad_hz"] <= 0:
            raise RuntimeError("Pad not connected.")
        return self.samples.taught()

    def _pose(self):
        return np.asarray(self.samples.fresh("tcp")["pose_m_rad"], dtype=float)

    def _fz(self):
        return float(self.samples.fresh("force")["contact_force_n"])

    def _await_pose(self, target, timeout, *, translation_only=False):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            self.status()
            live = self._pose()
            delta = live[:3] - target[:3]
            if translation_only:
                z = -outward(live)
                delta -= np.dot(delta, z) * z
            rot = (Rotation.from_euler("xyz", live[3:]).inv() *
                   Rotation.from_euler("xyz", target[3:])).as_rotvec()
            rot_err = np.linalg.norm(rot[[0, 2]]) if translation_only else np.linalg.norm(rot)
            if np.linalg.norm(delta) <= (0.005 if translation_only else 0.002) and rot_err < np.deg2rad(3):
                return
            time.sleep(0.02)
        raise RuntimeError("TCP target timeout.")

    def _await_pose_stable(self, target, timeout, *, settle_s=0.25,
                           position_tol_m=0.0005, rotation_tol_rad=None):
        """Wait until a target pose is held continuously for ``settle_s``."""
        target = np.asarray(target, dtype=float).reshape(-1)
        if target.size != 6 or not np.all(np.isfinite(target)):
            raise ValueError("TCP target must contain six finite values")
        if rotation_tol_rad is None:
            rotation_tol_rad = np.deg2rad(0.3)
        deadline = time.monotonic() + max(float(timeout), 0.0)
        stable_since = None
        while time.monotonic() < deadline:
            self.status()
            live = self._pose()
            delta = np.asarray(live[:3], dtype=float) - target[:3]
            rot = (Rotation.from_euler("xyz", live[3:]).inv() *
                   Rotation.from_euler("xyz", target[3:])).as_rotvec()
            within = (np.linalg.norm(delta) <= float(position_tol_m)
                      and np.linalg.norm(rot) <= float(rotation_tol_rad))
            now = time.monotonic()
            if within:
                if stable_since is None:
                    stable_since = now
                elif now - stable_since >= max(float(settle_s), 0.0):
                    return
            else:
                stable_since = None
            time.sleep(0.02)
        raise RuntimeError("TCP target did not settle.")

    @staticmethod
    def _apex_pose(apex):
        if not isinstance(apex, dict) or "pose_m_rad" not in apex:
            raise ValueError("calibration apex must be the capture() result")
        pose = np.asarray(apex["pose_m_rad"], dtype=float).reshape(-1)
        if pose.size != 6 or not np.all(np.isfinite(pose)):
            raise ValueError("calibration apex pose must contain six finite values")
        return pose.copy()

    def lock_calibration_apex(self, apex):
        """Immediately take the taught apex out of pad/force control and hold it."""
        pose = self._apex_pose(apex)
        self.status()
        ret = self.arm.clear_force_control()
        if ret != 0:
            raise RuntimeError(f"Failed to clear force overlay: {ret}.")
        self._calibration_apex = pose.copy()
        self.automatic = True
        self._accepted(self.arm.track_pose(
            pose.tolist(), block=0, soft_start=False, label="icra_delay_cal_apex_hold"))
        self._await_pose_stable(pose, 8.0)
        print("[APEX] Locked calibration apex.", flush=True)
        return pose.copy()

    def _wait_air(self):
        deadline, release = time.monotonic() + 5, ReleaseDetector()
        while time.monotonic() < deadline:
            self.status()
            if release.update(self.samples.fresh("force")):
                self.air_verified = True
                return
            time.sleep(0.02)
        raise RuntimeError("Release not confirmed after retract.")

    def withdraw(self):
        self.status()
        print("[RETRACT] 30 mm.", flush=True)
        live = self._pose()
        target = lift_pose(live, 0.03)
        self.arm.clear_force_control()
        self._accepted(self.arm.cartesian_track(poses=[live.tolist(), target.tolist()],
                    reference="polyline", speed_m_s=0.010, soft_start=True, ramp_s=0.4,
                    label="icra_retract", block=0))
        self._await_pose(target, 10)
        self._wait_air()

    def prepare(self, spec):
        snap = self.status()
        if (snap["status"] == int(Status.RUNNING)
                and not pad_may_drive(snap["mode"], label=snap["msg"])
                and not str(snap["msg"]).startswith("icra_")):
            raise RuntimeError("Another automatic task is active.")
        self.automatic = True
        self.stages = {}
        self.mark("prepare_begin")
        if not self.air_verified or abs(self._fz()) >= RELEASE_N:
            self.withdraw()
        ref = ForearmReference(spec)
        target = lift_pose(ref.sample(0).pose_d, 0.03)
        self._air_motion = True
        print("[MOVEJ] Start standoff.", flush=True)
        self._accepted(self.arm.movej_p(target.tolist(), v=0.20, block=0, label="icra_movej"))
        deadline = time.monotonic() + 45
        while True:
            snap = self.status()
            if int(snap["done_seq"]) >= self.expected_seq:
                break
            if time.monotonic() > deadline:
                raise RuntimeError("MOVEJ timeout.")
            time.sleep(0.02)
        self._await_pose(target, 3)
        self._wait_air()
        self._standoff_target = target.copy()
        self.status()
        self.mark("standoff_ready")

    def preflight_contact_qp(self, config):
        """Read-only daemon capability check, before teaching or preparation motion."""
        from peirastic.core.capabilities import study_capabilities
        for capability in study_capabilities(config):
            self.arm.client.require_capability(capability)

    def scan(self, spec, recording, *, contact_qp=None):
        ref = ForearmReference(spec)
        start_pose = ref.sample(0).pose_d
        self._await_pose(lift_pose(start_pose, 0.03), 1)
        self._recording = recording
        self.status()
        self.air_verified = False
        self.arm.clear_force_control()
        self.arm.set_force_control(force_axes=SCAN_FORCE_AXES, control_frame="tool",
                                   max_vz_tool_m_s=0.010)
        self.arm.set_force_raw_override(dict(force_profile(self.args.force_profile), v_seek_free_m_s=0.010))
        self._standoff_target = None
        self._air_motion = False
        self.mark("seek_begin")
        print("[SEEK] Waiting for contact.", flush=True)
        study_options = {} if contact_qp is None else {"contact_qp": contact_qp}
        law = "contact_qp" if contact_qp is not None and contact_qp.get("mode") == "active" else "tff"
        self._accepted(self.arm.hfpc(reference="icra_path", path_spec=spec, law=law, force=4.0,
                     force_axes=SCAN_FORCE_AXES, wait_for_contact=True,
                     scan_contact_n=ENTRY_N, scan_contact_s=ENTRY_S, label="icra_scan", block=0,
                     **study_options))
        seek_started = time.monotonic()
        tracking_started = None
        release = ReleaseDetector()
        try:
            while True:
                snap = self.status()
                now = time.monotonic()
                message = str(snap["msg"])
                if message.startswith(("icra_scan:approach", "icra_scan:tracking")) and "scan_gate=4.0" not in message:
                    raise RuntimeError("Restart the updated controller; scan gate missing.")
                if "icra_scan:tracking" in message and tracking_started is None:
                    tracking_started = now
                    self.mark("tracking_observed")
                    print("[SCAN] Running.", flush=True)
                if int(snap["done_seq"]) >= self.expected_seq:
                    if tracking_started is None:
                        raise RuntimeError("Task ended before scan started.")
                    self.mark("path_done")
                    break
                if tracking_started is None:
                    if now - seek_started > 25:
                        raise RuntimeError("Contact timeout (25 s).")
                    gap = float((self._pose()[:3] - start_pose[:3]) @ outward(start_pose))
                    if gap < -0.010:
                        raise RuntimeError("Seek depth limit reached (10 mm).")
                else:
                    if release.update(self.samples.fresh("force")):
                        self.mark("contact_lost")
                        # A valid low-force observation is recoverable while
                        # telemetry and controller remain healthy. R3/errors
                        # still abort through status(), with no recovery move.
                        self.mark("retract_begin")
                        self.withdraw()
                        self.mark("retract_end")
                        self.park()
                        raise RuntimeError("Contact lost before path end; retracted. Raw kept.")
                    if now - tracking_started > 4 * ref.duration_s + 12:
                        raise RuntimeError("Scan timeout.")
                time.sleep(0.02)
            self._await_pose(ref.sample(ref.duration_s).pose_d, 2, translation_only=True)
            self.mark("retract_begin")
            self.withdraw()
            self.mark("retract_end")
            self.park()
        finally:
            self._recording = None
        return dict(self.stages)

    def run_tool_z_sine(self, recording, *, amplitude_m, period_s, duration_s, ramp_s,
                        apex=None):
        """Position-track one +tool-Z sine from the already locked apex.

        The explicit origin is sent with the mode request because Window A
        reseeds references from live encoders at phase entry.  This prevents a
        small hold error or a segment transition from silently changing the
        calibration origin.
        """
        if apex is None:
            apex = self._calibration_apex
        pose = self._apex_pose(apex) if isinstance(apex, dict) else self._apex_pose(
            {"pose_m_rad": apex})
        if (self._calibration_apex is not None and
                not np.allclose(pose, self._calibration_apex, atol=1.0e-9, rtol=0.0)):
            raise ValueError("run apex differs from the locked calibration apex")
        self._calibration_apex = pose.copy()
        if not np.isfinite(float(period_s)) or float(period_s) <= 0:
            raise ValueError("period_s must be positive")
        if not np.isfinite(float(duration_s)) or float(duration_s) <= 0:
            raise ValueError("duration_s must be positive")
        if not np.isfinite(float(ramp_s)) or float(ramp_s) < 0:
            raise ValueError("ramp_s must be non-negative")
        self.status()
        self.automatic = True
        self.stages = {}
        self._recording = recording
        self.air_verified = False
        self._air_motion = False
        self._standoff_target = None
        ret = self.arm.clear_force_control()
        if ret != 0:
            raise RuntimeError(f"Failed to clear force overlay: {ret}.")
        # Confirm the locked apex at the start of every segment; do not use the
        # live pose as a new origin.
        self._await_pose_stable(pose, 8.0)
        period_s = float(period_s)
        duration_s = float(duration_s)
        ramp_s = float(ramp_s)
        self.mark("motion_begin")
        print(f"[SINE] Tool-Z {1.0 / period_s:g} Hz from locked apex.", flush=True)
        self._accepted(self.arm.cartesian_track(
            reference="tool_z_sine", amplitude_z_m=float(amplitude_m), period_s=period_s,
            duration_s=duration_s, ramp_s=ramp_s, stop_ramp_s=ramp_s,
            origin_pose=pose.tolist(), soft_start=True,
            label="icra_delay_cal_z", block=0))
        deadline = time.monotonic() + duration_s + ramp_s + 20.0
        try:
            while True:
                snap = self.status()
                if int(snap["done_seq"]) >= self.expected_seq:
                    break
                if time.monotonic() > deadline:
                    raise RuntimeError("Tool-Z sine timeout.")
                time.sleep(0.02)
            self.mark("motion_end")
            margin_ns = int(round((ramp_s + period_s) * 1.0e9))
            self.stages["fit_begin"] = int(self.stages["motion_begin"]) + margin_ns
            self.stages["fit_end"] = int(self.stages["motion_end"]) - margin_ns
            if self.stages["fit_end"] <= self.stages["fit_begin"]:
                raise RuntimeError("Calibration motion is too short for its fit window.")
            self._accepted(self.arm.track_pose(
                pose.tolist(), label="icra_delay_cal_hold", block=0, soft_start=False))
            self._await_pose_stable(pose, 8.0)
            self.automatic = False
            print("[READY] Holding the apex pose.", flush=True)
        finally:
            self._recording = None
        return dict(self.stages)

    def calibration_pause(self, seconds, recording):
        """Keep the same apex held while the recorder spans two sine segments."""
        seconds = float(seconds)
        if not np.isfinite(seconds) or seconds < 0:
            raise ValueError("calibration pause must be non-negative")
        if self._calibration_apex is None:
            raise RuntimeError("Calibration apex is not locked")
        previous_recording = self._recording
        self._recording = recording
        try:
            self.automatic = True
            self._await_pose_stable(self._calibration_apex, 8.0)
            deadline = time.monotonic() + seconds
            while time.monotonic() < deadline:
                self.status()
                time.sleep(min(0.02, max(0.0, deadline - time.monotonic())))
            self._await_pose_stable(self._calibration_apex, 8.0)
            self.automatic = False
            print(f"[PAUSE] Apex held for {seconds:g} s.", flush=True)
        finally:
            self._recording = previous_recording

    def park(self):
        pose = self._pose()
        self._accepted(self.arm.cartesian_track(reference="polyline", poses=[pose.tolist()],
                       speed_m_s=0.01, label="icra_wait", block=0))
        self.automatic = False
        print("[READY] Probe clear.", flush=True)

    def stop(self):
        self._recording = None
        self._standoff_target = None
        self._air_motion = False
        self.air_verified = False
        if self.automatic or self.expected_seq is not None:
            try:
                ret = self.arm.set_arm_stop()
                if ret != 0:
                    raise RuntimeError(f"Arm stop rejected: {ret}.")
            finally:
                self.expected_seq = None
                self.automatic = False

    def close(self):
        self.samples.close()
        self.arm.close()
        os.close(self.lock_fd)
