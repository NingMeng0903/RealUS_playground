{
  "schema": "archived_command_model_work_v1",
  "git_head": "669beac6668f659aaa05f92c5425ca0235f0523b",
  "method": {
    "wrench": "W_model=-W_control_raw_tcp; physical_wrench_candidate_tool preferred, control_wrench_tool fallback explicitly counted",
    "velocity": "successful publication.final_command_model_tool matched to control_sample by control_id",
    "power": "P_model=-W_model dot V = W_control dot V; force and velocity are held together in their publication TCP/body axes on each interval",
    "time": "[successful publication.record_monotonic_s_i, successful publication.record_monotonic_s_i+1); include only matched control h_ref_s>0; no terminal tail extrapolation; no timestamp sorting",
    "frame": "both vectors are the original paired TCP/tool components; never pair a new-frame force with an old-frame velocity; physical rotation, force evolution and execution are not reconstructed",
    "positive_work": "integral max(sum of six paired power components,0), not sum of independently clipped axis powers",
    "max_prefix": "max(0, prefix sum of signed work), initial zero included",
    "max_drawup": "max(prefix - prior running minimum), supplementary finite-capacity reference with lost recovered credit",
    "interval_thresholds_s": {
      "short_lt": 0.0025,
      "long_gt": 0.01,
      "also_reported_long_gt": 0.015
    },
    "limitations": [
      "Command-model calculation only, not measured physical work or passivity certification.",
      "record_monotonic_s is logging time after reported publication success, not actual actuator execution onset.",
      "Compensated force and final command are sampled at different moments within the same control transaction and held as a model.",
      "No conservative wrench/tracking/hold-error bounds, damping charge, stopping reserve, or command pipeline overlap are included.",
      "Unknown terminal hold duration is excluded; no confirmed physical stop is inferred from a stop log.",
      "The current changed calibration files are not re-applied; archived compensated wrench values are used verbatim."
    ]
  },
